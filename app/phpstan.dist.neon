includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    # Not analysed (migrations aren't held to the same rules as src/), but scanned so PHPStan can
    # resolve DoctrineMigrations\* classes that tests/Unit/Migrations/*Test.php require_once and
    # instantiate directly to exercise a specific migration's up()/postUp() against a real
    # SQLite connection.
    scanDirectories:
        - migrations
    # Standalone CLI worker scripts spawned as child processes by PluginsConfigStoreConcurrencyTest
    # and AppConfigStoreConcurrencyTest (via Symfony\Component\Process), not PHPUnit test classes —
    # rely on $argv like any CLI entry point (bin/console), which PHPStan can't see outside a real
    # CLI invocation.
    excludePaths:
        - tests/Fixtures/Plugin/increment-counter.php
        - tests/Fixtures/Plugin/reconcile-loop.php
        - tests/Fixtures/Plugin/install-plugin.php
        - tests/Fixtures/set-config-key.php
    bootstrapFiles:
        - tests/bootstrap.php
