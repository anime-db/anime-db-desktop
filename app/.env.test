# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Without this, %app.config_path% falls back to its dev default (var/config.json) — the same
# file the locally running app writes to — so the test suite ends up reading whatever theme,
# locale, etc. a developer set through the live UI on their own machine (issue #650). Pointing
# it at a dedicated path under var/ keeps the suite isolated from that file; the path is not
# read from nor written to by anything else, so nothing here ever populates it.
CONFIG_PATH='var/test/config.json'
