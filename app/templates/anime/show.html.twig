{% extends 'base.html.twig' %}

{% block title %}{{ 'anime_detail.title'|trans({'%title%': anime.title}) }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/anime-detail.css') }}">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/anime-detail.js') }}"></script>
{% endblock %}

{% block body %}
    <main class="anime-detail">
        <div class="anime-detail__media">
            {% if anime.cover %}
                <img class="anime-detail__cover" src="app-media://anime/{{ anime.id }}/{{ anime.cover }}" alt="{{ anime.title }}">
            {% else %}
                <div class="anime-detail__cover anime-detail__cover--placeholder">{{ 'anime_detail.no_cover'|trans }}</div>
            {% endif %}
            <h1 class="anime-detail__title">{{ anime.title }}</h1>
        </div>

        <div class="anime-detail__content">
            {{ include('anime/_editable.html.twig', {anime: anime, editing: null, error: null}) }}

            <section class="anime-detail__labels"
                     data-labels-widget
                     data-labels="{{ anime.labels|json_encode }}"
                     data-update-url="{{ path('anime_labels_update', {id: anime.id}) }}"
                     data-search-url="{{ path('labels_index') }}"
                     data-csrf-token="{{ csrf_token('anime_labels_update_' ~ anime.id) }}">
                <div class="anime-detail__labels-header">
                    <h2 class="anime-detail__labels-heading">{{ 'anime_detail.labels_heading'|trans }}</h2>
                    <button type="button" class="anime-detail__labels-edit-button" data-labels-edit
                            title="{{ 'anime_detail.labels_edit_button'|trans }}"
                            aria-label="{{ 'anime_detail.labels_edit_button'|trans }}">&#9998;</button>
                </div>

                <ul class="anime-detail__labels-list" data-labels-view>
                    {% for label in anime.labels %}
                        <li><a class="anime-detail__label-link" href="{{ path('home_index', {labels: label.id}) }}">{{ label.name }}</a></li>
                    {% else %}
                        <li class="anime-detail__labels-empty" data-labels-empty>{{ 'anime_detail.empty_value'|trans }}</li>
                    {% endfor %}
                </ul>

                <div class="anime-detail__labels-editor" data-labels-editor hidden>
                    <ul class="anime-detail__labels-chips" data-labels-chips></ul>
                    <input type="text" class="anime-detail__labels-input" data-labels-input
                           placeholder="{{ 'anime_detail.labels_input_placeholder'|trans }}"
                           aria-label="{{ 'anime_detail.labels_input_placeholder'|trans }}"
                           autocomplete="off">
                    <ul class="anime-detail__labels-suggestions" data-labels-suggestions hidden></ul>
                    <p class="anime-detail__labels-error" data-labels-error hidden>{{ 'anime_detail.labels_save_error'|trans }}</p>
                    <div class="anime-detail__labels-actions">
                        <button type="button" class="anime-detail__labels-save-button" data-labels-save>{{ 'anime_detail.labels_save_button'|trans }}</button>
                        <button type="button" class="anime-detail__labels-cancel-button" data-labels-cancel>{{ 'anime_detail.labels_cancel_button'|trans }}</button>
                    </div>
                </div>
            </section>

            <section class="anime-detail__summary">
                <h2 class="anime-detail__section-heading">{{ 'anime_detail.field_summary'|trans }}</h2>
                <p class="anime-detail__summary-text">
                    {{- anime.summary is not empty ? anime.summary : ('anime_detail.empty_value'|trans) -}}
                </p>
            </section>

            <section class="anime-detail__reference">
                <h2 class="anime-detail__section-heading">{{ 'anime_detail.reference_heading'|trans }}</h2>

                <span class="anime-detail__status-badge anime-detail__status-badge--{{ anime.production_status }}">
                    {{ ('production_status.' ~ anime.production_status)|trans }}
                </span>

                <dl class="anime-detail__fields">
                    <dt>{{ 'anime_detail.field_type'|trans }}</dt>
                    <dd>{{ ('anime_type.' ~ anime.type)|trans }}</dd>

                    {% if anime.episodes_count is not null %}
                        <dt>{{ 'anime_detail.field_episodes_count'|trans }}</dt>
                        <dd>{{ anime.episodes_count }}</dd>
                    {% endif %}

                    <dt>{{ 'anime_detail.field_duration_minutes'|trans }}</dt>
                    <dd>
                        {%- if anime.duration_minutes is not null %}
                            {{- anime.duration_minutes }} {{ 'anime_detail.duration_minutes_suffix'|trans }}
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_studios'|trans }}</dt>
                    <dd>{{ anime.studios is not empty ? anime.studios|join(', ') : ('anime_detail.empty_value'|trans) }}</dd>

                    <dt>{{ 'anime_detail.field_countries'|trans }}</dt>
                    <dd>{{ anime.countries is not empty ? anime.countries|join(', ') : ('anime_detail.empty_value'|trans) }}</dd>

                    <dt>{{ 'anime_detail.field_storage'|trans }}</dt>
                    <dd>
                        {%- if anime.storage %}
                            {{- anime.storage.name }} ({{ ('storage_type.' ~ anime.storage.type)|trans }})
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_storage_path'|trans }}</dt>
                    <dd>
                        {%- if anime.storage %}
                            {{- anime.storage.path }}
                            <button
                                type="button"
                                class="anime-detail__open-folder-button"
                                data-open-folder-path="{{ anime.storage.path }}"
                                {%- if not anime.storage.path_available %}
                                    disabled
                                    title="{{ 'anime_detail.path_unavailable_tooltip'|trans }}"
                                {%- endif %}
                            >{{ 'anime_detail.open_folder_button'|trans }}</button>
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_names'|trans }}</dt>
                    <dd>
                        {% if anime.names is not empty %}
                            <ul class="anime-detail__names">
                                {% for name in anime.names %}
                                    <li>{{ name.name }} <span class="anime-detail__name-type">({{ ('anime_name_type.' ~ name.type)|trans }})</span></li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            {{ 'anime_detail.empty_value'|trans }}
                        {% endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_genres'|trans }}</dt>
                    <dd>
                        {%- if anime.genres is not empty %}
                            {%- for code in anime.genres %}{{ ('genre.' ~ code)|trans }}{% if not loop.last %}, {% endif %}{% endfor %}
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_themes'|trans }}</dt>
                    <dd>
                        {%- if anime.themes is not empty %}
                            {%- for code in anime.themes %}{{ ('theme.' ~ code)|trans }}{% if not loop.last %}, {% endif %}{% endfor %}
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>

                    <dt>{{ 'anime_detail.field_demographic'|trans }}</dt>
                    <dd>
                        {%- if anime.demographic is not null %}
                            {{- ('demographic.' ~ anime.demographic)|trans }}
                        {%- else %}
                            {{- 'anime_detail.empty_value'|trans }}
                        {%- endif %}
                    </dd>
                </dl>
            </section>

            {% if anime.sources is not empty %}
                <section class="anime-detail__sources">
                    <h2 class="anime-detail__section-heading">{{ 'anime_detail.sources_heading'|trans }}</h2>

                    <ul class="anime-detail__source-list">
                        {% for source in anime.sources %}
                            <li>
                                <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer" class="anime-detail__source-link" title="{{ source.domain }}">
                                    <img src="https://{{ source.domain }}/favicon.ico" alt="{{ source.domain }}" class="anime-detail__source-icon" loading="lazy">
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if anime.images is not empty %}
                <section class="anime-detail__gallery">
                    <h2 class="anime-detail__section-heading">{{ 'anime_detail.gallery_heading'|trans }}</h2>

                    <ul class="anime-detail__gallery-list">
                        {% for image in anime.images %}
                            <li>
                                <img src="app-media://anime/{{ anime.id }}/{{ image }}" alt="{{ anime.title }}" class="anime-detail__gallery-image" loading="lazy">
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </div>
    </main>
{% endblock %}
