{#
 # Rendered both by anime/show.html.twig (initial load, error = null) and by
 # DownloadUnlinkController::unlink() (HTMX fragment swap, issue #857). No rows for this anime —
 # no block at all; a successful unlink that empties the list swaps this element away entirely.
 #}
{% if downloads is not empty %}
    <section class="anime-detail__downloads" id="anime-downloads-{{ anime.id }}">
        <h2 class="anime-detail__section-heading">{{ 'anime_detail.downloads_heading'|trans }}</h2>

        {% if error %}
            <p class="anime-detail__downloads-error">{{ error|trans }}</p>
        {% endif %}

        <ul class="anime-detail__downloads-list">
            {% for download in downloads %}
                <li class="anime-detail__downloads-item">
                    <span class="anime-detail__downloads-status anime-detail__downloads-status--{{ download.status }}">
                        {{ ('download_status.' ~ download.status)|trans }}
                    </span>
                    {% if download.status == 'completed' %}
                    <form class="anime-detail__downloads-unlink-form"
                          hx-post="{{ path('download_unlink', {id: download.id}) }}"
                          hx-target="#anime-downloads-{{ anime.id }}" hx-swap="outerHTML">
                        <input type="hidden" name="_token" value="{{ csrf_token('download_unlink_' ~ download.id) }}">
                        <input type="hidden" name="version" value="{{ download.version }}">
                        <input type="hidden" name="status" value="{{ download.status }}">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'anime_detail.downloads_unlink_button'|trans }}</button>
                    </form>
                    {% else %}
                    <a class="anime-detail__downloads-manage-link" href="{{ path('downloads_index') }}">{{ 'anime_detail.downloads_manage_link'|trans }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
