{#
 # Card header: title and the "japanese title · type · years" subtitle. Rendered by
 # anime/show.html.twig and, as an out-of-band swap (oob = true), by AnimeFillController after an
 # alternativeNames fill: the official Japanese title shown here comes from the same names.
 #}
{% set japanese_name = (anime.names|filter(name => name.role == 'official' and name.locale == 'ja')|first)|default(null) %}
{% set date_premiere = anime.date_premiere|default(null) %}
{% set date_end = anime.date_end|default(null) %}
{% set year_start = date_premiere is not null ? date_premiere|slice(0, 4) : null %}
{% set year_end = date_end is not null ? date_end|slice(0, 4) : null %}
{% set years = year_start is not null and year_end is not null and year_end != year_start ? year_start ~ '–' ~ year_end : (year_start ?? year_end) %}
{% set subtitle_parts = [] %}
{% if japanese_name %}{% set subtitle_parts = subtitle_parts|merge([japanese_name.name]) %}{% endif %}
{% set subtitle_parts = subtitle_parts|merge([('anime_type.' ~ anime.type)|trans]) %}
{% if years is not null %}{% set subtitle_parts = subtitle_parts|merge([years]) %}{% endif %}

<header class="anime-detail__header" id="anime-header-{{ anime.id }}"{% if oob|default(false) %} hx-swap-oob="outerHTML"{% endif %}>
    <h1 class="anime-detail__title"><bdi>{{ anime.title }}</bdi></h1>
    <p class="anime-detail__subtitle">{{ subtitle_parts|join(' · ') }}</p>
</header>
