{#
 # Card header: title and the "japanese title · type · years" subtitle. Rendered by
 # anime/show.html.twig and, as an out-of-band swap (oob = true), by AnimeFillController after an
 # alternativeNames fill: the official Japanese title shown here comes from the same names.
 #}
{% from 'anime/_delete_confirm.html.twig' import delete_confirm, delete_modal %}
{% from 'anime/_type_change_modal.html.twig' import type_change_modal %}
{% set delete_plan = delete_source_removal|default(null) %}
{% set type_changes = anime.type_changes|default([]) %}
{% set japanese_name = (anime.names|filter(name => name.role == 'official' and name.locale == 'ja')|first)|default(null) %}
{% set date_premiere = anime.date_premiere|default(null) %}
{% set date_end = anime.date_end|default(null) %}
{% set year_start = date_premiere is not null ? date_premiere|slice(0, 4) : null %}
{% set year_end = date_end is not null ? date_end|slice(0, 4) : null %}
{% set years = year_start is not null and year_end is not null and year_end != year_start ? year_start ~ '–' ~ year_end : (year_start ?? year_end) %}
{% set subtitle_parts = [] %}
{% if japanese_name %}{% set subtitle_parts = subtitle_parts|merge([japanese_name.name]) %}{% endif %}
{% set subtitle_parts = subtitle_parts|merge([('anime_type.' ~ anime.type)|trans]) %}
{% if years is not null %}{% set subtitle_parts = subtitle_parts|merge([years]) %}{% endif %}

<header class="anime-detail__header" id="anime-header-{{ anime.id }}"{% if oob|default(false) %} hx-swap-oob="outerHTML"{% endif %}>
    <div class="anime-detail__heading">
        <h1 class="anime-detail__title"><bdi>{{ anime.title }}</bdi></h1>
        <p class="anime-detail__subtitle">{{ subtitle_parts|join(' · ') }}</p>
    </div>

    {# Entry actions menu: each later action adds its own <li> here. #}
    <div class="dropdown anime-detail__menu">
        <button type="button" class="btn btn-outline-secondary anime-detail__menu-toggle" data-bs-toggle="dropdown" aria-expanded="false"
                title="{{ 'anime_detail.menu_button'|trans }}" aria-label="{{ 'anime_detail.menu_button'|trans }}">{{ icon('three-dots') }}</button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="{{ path('anime_edit', {id: anime.id}) }}">{{ 'anime_detail.menu_edit'|trans }}</a></li>
            {% if type_changes is not empty %}
                <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#anime-type-modal-{{ anime.id }}">{{ 'anime_detail.menu_change_type'|trans }}</button></li>
            {% endif %}
            <li>
                {% if delete_plan is not null and delete_plan.hasTargets %}
                    <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#anime-delete-modal-{{ anime.id }}">{{ 'anime_detail.menu_delete'|trans }}</button>
                {% else %}
                    <form method="post" action="{{ path('anime_delete', {id: anime.id}) }}"
                          data-confirm="{{ delete_confirm(anime.title, anime.storage is not null, delete_has_finished_downloads|default(false)) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('anime_delete_' ~ anime.id) }}">
                        <button type="submit" class="dropdown-item text-danger">{{ 'anime_detail.menu_delete'|trans }}</button>
                    </form>
                {% endif %}
            </li>
        </ul>
    </div>
    {% if type_changes is not empty %}
        {{ type_change_modal('anime-type-modal-' ~ anime.id, path('anime_change_type', {id: anime.id}), csrf_token('anime_change_type_' ~ anime.id), anime) }}
    {% endif %}
    {% if delete_plan is not null and delete_plan.hasTargets %}
        {{ delete_modal('anime-delete-modal-' ~ anime.id, path('anime_delete', {id: anime.id}), csrf_token('anime_delete_' ~ anime.id), anime.title, anime.storage is not null, delete_has_finished_downloads|default(false), delete_plan) }}
    {% endif %}
</header>
