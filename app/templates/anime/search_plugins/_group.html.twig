{#
 # Rendered both as the swap target of its own loading placeholder (_results.html.twig) and
 # directly by AnimeSearchPluginsController::group(). state is one of 'results'/'empty'/'error'
 # (issue #833, point 2) - a plugin's own find() exception never reaches this far, it is already
 # turned into 'error' by the controller, so this template only ever displays a state, never
 # throws one.
 #}
<section class="search-plugins__group" id="search-plugins-group-{{ pluginId }}">
    <h2 class="search-plugins__group-heading"><bdi>{{ pluginName }}</bdi></h2>

    {% if state == 'error' %}
        <p class="search-plugins__group-error">{{ 'search_plugins.group_error'|trans }}</p>
    {% elseif state == 'empty' %}
        <p class="search-plugins__group-empty">{{ 'search_plugins.group_empty'|trans }}</p>
    {% else %}
        <ul class="search-plugins__candidates">
            {% for candidate in candidates %}
                <li>
                    <button
                        type="button"
                        class="search-plugins__candidate"
                        hx-get="{{ path('anime_search_plugins_preview', {plugin_id: pluginId, external_id: candidate.externalId, name: candidate.name}) }}"
                        hx-target="#search-plugins-preview"
                        hx-swap="innerHTML"
                    ><bdi>{{ candidate.name }}</bdi></button>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
