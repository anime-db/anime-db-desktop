{#
 # The user's notes (centre column). Rendered by anime/show.html.twig (initial load, oob = false)
 # and, as an out-of-band swap, by AnimeEditableController after a notes update (issue #913), since
 # every editable response otherwise replaces only #anime-editable-{id}. The root is always
 # emitted (hidden while there are no notes) so the first note has an anchor to be swapped into;
 # HTMX silently drops an out-of-band fragment whose id is not on the page.
 #}
<section class="anime-detail__notes" id="anime-notes-{{ anime.id }}"{% if oob|default(false) %} hx-swap-oob="outerHTML"{% endif %}{% if anime.notes is empty %} hidden{% endif %}>
    {% if anime.notes is not empty %}
        <div class="anime-detail__notes-header">
            <h2 class="anime-detail__section-heading">{{ 'anime_detail.field_notes'|trans }}</h2>
            <button
                type="button"
                class="anime-detail__editable-value"
                hx-get="{{ path('anime_editable_edit', {id: anime.id, field: 'notes'}) }}"
                hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML"
            >{{ 'anime_detail.notes_edit_button'|trans }}</button>
        </div>
        <p class="anime-detail__notes-text">{{ anime.notes }}</p>
    {% endif %}
</section>
