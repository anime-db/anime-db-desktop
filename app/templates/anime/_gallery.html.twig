{#
 # Rendered both by anime/show.html.twig (initial load) and, as an out-of-band swap, by
 # AnimeFillController after a successful images fill (issue #507). Unlike the pre-#507 markup,
 # this section always exists in the DOM, empty state included - an oob swap can only replace an
 # element that is already there by id, so a gallery hidden behind {% if anime.images is not
 # empty %} would have nowhere to land on the very first successful fill. Newly filled images are
 # added to the gallery, never replace it (see PluginAnimeDataMerger::applyImages()'s union-by-
 # filename dedup) - there is no per-image delete in this UI, so a replace semantic here would be
 # an unrecoverable data loss.
 #}
{% import 'anime/_fill_fields.html.twig' as fill %}

<section class="anime-detail__gallery" id="anime-gallery-{{ anime.id }}" hx-swap-oob="outerHTML">
    <h2 class="anime-detail__section-heading">{{ 'anime_detail.gallery_heading'|trans }}</h2>

    {% if anime.images is not empty %}
        <ul class="anime-detail__gallery-list">
            {% for image in anime.images %}
                <li>
                    <img src="app-media://anime/{{ anime.id }}/{{ image }}" alt="{{ anime.title }}" class="anime-detail__gallery-image" loading="lazy">
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="anime-detail__gallery-empty">{{ 'anime_detail.empty_value'|trans }}</p>
    {% endif %}

    {{ fill.fill_button(anime, 'images', fillable_fields.images) }}
</section>
