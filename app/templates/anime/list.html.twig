{% extends 'base.html.twig' %}

{% block title %}{{ 'anime_list.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/anime-list.css') }}">
{% endblock %}

{% block body %}
    <main class="anime-list">
        {% if showOnboarding %}
            <section class="onboarding-banner">
                <h2>{{ 'onboarding.heading'|trans }}</h2>
                <p>{{ 'onboarding.description'|trans }}</p>
                <a href="{{ path('storage_new') }}">{{ 'onboarding.add_storage_button'|trans }}</a>
                <form method="post" action="{{ path('onboarding_seed_demo') }}" class="onboarding-banner__demo-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('onboarding_seed_demo') }}">
                    <button type="submit">{{ 'onboarding.load_demo_button'|trans }}</button>
                </form>
            </section>
        {% endif %}

        <div class="anime-list__grid" id="anime-list-grid"></div>

        <p class="anime-list__empty" id="anime-list-empty" hidden>{{ 'anime_list.empty'|trans }}</p>
        <p class="anime-list__error" id="anime-list-error" hidden>{{ 'anime_list.error'|trans }}</p>

        <nav class="anime-list__pagination" id="anime-list-pagination" hidden></nav>
        <div class="anime-list__sentinel" id="anime-list-sentinel" hidden></div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/anime-list.js') }}"></script>
{% endblock %}
