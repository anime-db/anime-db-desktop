{#
 # Rendered both by anime/show.html.twig (initial load, oob = false) and, as an out-of-band
 # swap, by AnimeFillController after any cover fill attempt - success or rejection alike, so a
 # "not found"/"rejected" notice appears right next to the button that triggered it instead of
 # in the unrelated fields fragment (issue #507). A stable id lets HTMX match this partial
 # regardless of which form's hx-target actually issued the request. hx-swap-oob is only emitted
 # when oob = true: the attribute only makes sense on a fragment delivered as an out-of-band
 # swap, not on the copy included directly by show.html.twig's own document. cover always
 # overwrites (see PluginAnimeDataMerger::applyCover()), so the fill button here has no "add"
 # semantics to worry about, unlike the gallery's. The title heading lives in the card header
 # (show.html.twig), not here (issue #913), so this fragment is just the cover and its fill button.
 #}
{% import 'anime/_fill_button.html.twig' as fill %}

<div class="anime-detail__media" id="anime-media-{{ anime.id }}"{% if oob|default(false) %} hx-swap-oob="outerHTML"{% endif %}>
    {% if fill_error|default(null) %}
        <p class="anime-detail__fill-error">{{ fill_error|trans }}</p>
    {% endif %}

    {% if anime.cover %}
        <img class="anime-detail__cover" src="app-media://anime/{{ anime.id }}/{{ anime.cover }}" alt="{{ anime.title }}">
    {% else %}
        <div class="anime-detail__cover anime-detail__cover--placeholder"></div>
    {% endif %}

    {{ fill.fill_button(anime, 'cover', fillable_fields.cover) }}
</div>
