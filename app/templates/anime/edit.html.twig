{% extends 'base.html.twig' %}

{% macro field_error(errors, key) %}
    {% if errors[key] is defined %}
        <div class="invalid-feedback d-block" data-field-error="{{ key }}">{{ errors[key]|trans }}</div>
    {% endif %}
{% endmacro %}

{% macro name_row(index, row, roles, errors) %}
    {% import _self as m %}
    <div class="anime-edit__row" data-rows-item>
        <div class="anime-edit__row-fields">
            <input type="text" name="names[{{ index }}][name]" value="{{ row.name }}" maxlength="256" class="form-control" placeholder="{{ 'anime_edit.field_name'|trans }}" aria-label="{{ 'anime_edit.field_name'|trans }}">
            <input type="text" name="names[{{ index }}][locale]" value="{{ row.locale }}" maxlength="16" class="form-control anime-edit__locale" placeholder="{{ 'anime_edit.field_locale'|trans }}" aria-label="{{ 'anime_edit.field_locale'|trans }}">
            <select name="names[{{ index }}][role]" class="form-select anime-edit__role" aria-label="{{ 'anime_edit.field_role'|trans }}">
                {% for role in roles %}
                    <option value="{{ role }}"{% if role == row.role %} selected{% endif %}>{{ ('anime_name_role.' ~ role)|trans }}</option>
                {% endfor %}
            </select>
            <button type="button" class="btn btn-outline-secondary" data-rows-remove aria-label="{{ 'anime_edit.remove_button'|trans }}" title="{{ 'anime_edit.remove_button'|trans }}">{{ icon('x-lg') }}</button>
        </div>
        {{ m.field_error(errors, 'names.' ~ index) }}
    </div>
{% endmacro %}

{% macro description_row(index, row, errors) %}
    {% import _self as m %}
    <div class="anime-edit__row" data-rows-item>
        <div class="anime-edit__row-fields">
            <input type="text" name="descriptions[{{ index }}][locale]" value="{{ row.locale }}" maxlength="8" class="form-control anime-edit__locale" placeholder="{{ 'anime_edit.field_locale'|trans }}" aria-label="{{ 'anime_edit.field_locale'|trans }}">
            <textarea name="descriptions[{{ index }}][text]" rows="3" class="form-control" aria-label="{{ 'anime_edit.field_description_text'|trans }}">{{ row.text }}</textarea>
            <button type="button" class="btn btn-outline-secondary" data-rows-remove aria-label="{{ 'anime_edit.remove_button'|trans }}" title="{{ 'anime_edit.remove_button'|trans }}">{{ icon('x-lg') }}</button>
        </div>
        {{ m.field_error(errors, 'descriptions.' ~ index) }}
    </div>
{% endmacro %}

{% macro text_row(field, index, value, errors, label) %}
    {% import _self as m %}
    <div class="anime-edit__row" data-rows-item>
        <div class="anime-edit__row-fields">
            <input type="{{ field == 'sources' ? 'url' : 'text' }}" name="{{ field }}[{{ index }}]" value="{{ value }}" class="form-control" aria-label="{{ label|trans }}">
            <button type="button" class="btn btn-outline-secondary" data-rows-remove aria-label="{{ 'anime_edit.remove_button'|trans }}" title="{{ 'anime_edit.remove_button'|trans }}">{{ icon('x-lg') }}</button>
        </div>
        {{ m.field_error(errors, field ~ '.' ~ index) }}
    </div>
{% endmacro %}

{% macro checkboxes(field, choices, selected, prefix) %}
    <div class="anime-edit__choices">
        {% for value in choices %}
            <label class="anime-edit__choice">
                <input type="checkbox" name="{{ field }}[]" value="{{ value }}"{% if value in selected %} checked{% endif %}>
                {{ (prefix ~ '.' ~ value)|trans }}
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{% macro studio_choice(studio, checked) %}
    <label class="anime-edit__choice" data-filter-item data-filter-text="{{ studio.name }}">
        <input type="checkbox" name="studios[]" value="{{ studio.id }}"{% if checked %} checked{% endif %}>
        {{ studio.name }}
    </label>
{% endmacro %}

{% block title %}{{ 'anime_edit.title'|trans({'%title%': anime.title}) }}{% endblock %}

{% block body %}
    {% import _self as m %}
    <main class="container py-4 anime-edit">
        {{ include('_back_link.html.twig', {url: path('anime_show', {id: anime.id}), label: 'anime_edit.back_link'|trans, inline: true}) }}

        <h1>{{ 'anime_edit.heading'|trans({'%title%': anime.title}) }}</h1>

        {% if errors is not empty %}
            <p class="alert alert-danger" data-form-error>{{ 'anime_edit.error_summary'|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('anime_update', {id: anime.id}) }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">

            <div class="mb-3">
                <label for="anime-edit-title" class="form-label">{{ 'anime_edit.field_title'|trans }}</label>
                <input type="text" id="anime-edit-title" name="title" value="{{ form.title }}" maxlength="256" required class="form-control">
                {{ m.field_error(errors, 'title') }}
            </div>

            <div class="mb-3" data-control="repeatable-rows">
                <label class="form-label">{{ 'anime_edit.field_names'|trans }}</label>
                <div data-rows-list>
                    {% for row in form.names %}{{ m.name_row(loop.index0, row, role_choices, errors) }}{% endfor %}
                </div>
                <template data-rows-template>{{ m.name_row('__INDEX__', {name: '', locale: '', role: 'synonym'}, role_choices, {}) }}</template>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-rows-add>{{ 'anime_edit.add_button'|trans }}</button>
            </div>

            <div class="mb-3" data-control="repeatable-rows">
                <label class="form-label">{{ 'anime_edit.field_descriptions'|trans }}</label>
                <div data-rows-list>
                    {% for row in form.descriptions %}{{ m.description_row(loop.index0, row, errors) }}{% endfor %}
                </div>
                <template data-rows-template>{{ m.description_row('__INDEX__', {locale: '', text: ''}, {}) }}</template>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-rows-add>{{ 'anime_edit.add_locale_button'|trans }}</button>
            </div>

            <div class="mb-3">
                <label class="form-label">{{ 'anime_edit.field_genres'|trans }}</label>
                {{ m.checkboxes('genres', genre_choices, form.genres, 'genre') }}
                {{ m.field_error(errors, 'genres') }}
            </div>

            <div class="mb-3">
                <label class="form-label">{{ 'anime_edit.field_themes'|trans }}</label>
                {{ m.checkboxes('themes', theme_choices, form.themes, 'theme') }}
                {{ m.field_error(errors, 'themes') }}
            </div>

            <div class="mb-3" data-control="repeatable-rows">
                <label class="form-label" for="anime-edit-studios-filter">{{ 'anime_edit.field_studios'|trans }}</label>
                <div data-control="choice-filter">
                    <input type="search" id="anime-edit-studios-filter" class="form-control form-control-sm mb-1" data-filter-input placeholder="{{ 'anime_edit.filter_studios'|trans }}" autocomplete="off">
                    <div class="anime-edit__choices anime-edit__choices--list" data-studio-choices>
                        {% for studio in studio_choices|filter(s => s.id in form.studios) %}{{ m.studio_choice(studio, true) }}{% endfor %}
                        {% for studio in studio_choices|filter(s => s.id not in form.studios) %}{{ m.studio_choice(studio, false) }}{% endfor %}
                    </div>
                </div>
                {{ m.field_error(errors, 'studios') }}
                <label class="form-label mt-2">{{ 'anime_edit.field_new_studios'|trans }}</label>
                <div data-rows-list>
                    {% for value in form.new_studios %}{{ m.text_row('new_studios', loop.index0, value, errors, 'anime_edit.field_new_studios') }}{% endfor %}
                </div>
                <template data-rows-template>{{ m.text_row('new_studios', '__INDEX__', '', {}, 'anime_edit.field_new_studios') }}</template>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-rows-add>{{ 'anime_edit.add_button'|trans }}</button>
                {{ m.field_error(errors, 'new_studios') }}
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label for="anime-edit-demographic" class="form-label">{{ 'anime_edit.field_demographic'|trans }}</label>
                    <select id="anime-edit-demographic" name="demographic" class="form-select">
                        <option value="">{{ 'anime_edit.demographic_none'|trans }}</option>
                        {% for value in demographic_choices %}
                            <option value="{{ value }}"{% if value == form.demographic %} selected{% endif %}>{{ ('demographic.' ~ value)|trans }}</option>
                        {% endfor %}
                    </select>
                    {{ m.field_error(errors, 'demographic') }}
                </div>
                <div class="col-md-4">
                    <label for="anime-edit-date-premiere" class="form-label">{{ 'anime_edit.field_date_premiere'|trans }}</label>
                    <input type="date" id="anime-edit-date-premiere" name="date_premiere" value="{{ form.date_premiere }}" class="form-control">
                    {{ m.field_error(errors, 'date_premiere') }}
                </div>
                <div class="col-md-4">
                    <label for="anime-edit-date-end" class="form-label">{{ 'anime_edit.field_date_end'|trans }}</label>
                    <input type="date" id="anime-edit-date-end" name="date_end" value="{{ form.date_end }}" class="form-control">
                    {{ m.field_error(errors, 'date_end') }}
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label for="anime-edit-duration" class="form-label">{{ 'anime_edit.field_duration_minutes'|trans }}</label>
                    <input type="text" inputmode="numeric" id="anime-edit-duration" name="duration_minutes" value="{{ form.duration_minutes }}" class="form-control">
                    {{ m.field_error(errors, 'duration_minutes') }}
                </div>
                {% if is_series %}
                    <div class="col-md-4">
                        <label for="anime-edit-episodes" class="form-label">{{ 'anime_edit.field_episodes_count'|trans }}</label>
                        <input type="text" inputmode="numeric" id="anime-edit-episodes" name="episodes_count" value="{{ form.episodes_count }}" class="form-control">
                        {{ m.field_error(errors, 'episodes_count') }}
                    </div>
                {% endif %}
                <div class="col-md-4">
                    <label for="anime-edit-countries" class="form-label">{{ 'anime_edit.field_countries'|trans }}</label>
                    <input type="text" id="anime-edit-countries" name="countries" value="{{ form.countries }}" placeholder="JP, US" class="form-control">
                    {{ m.field_error(errors, 'countries') }}
                </div>
            </div>

            <div class="mb-3" data-control="repeatable-rows">
                <label class="form-label">{{ 'anime_edit.field_sources'|trans }}</label>
                <div data-rows-list>
                    {% for value in form.sources %}{{ m.text_row('sources', loop.index0, value, errors, 'anime_edit.field_sources') }}{% endfor %}
                </div>
                <template data-rows-template>{{ m.text_row('sources', '__INDEX__', '', {}, 'anime_edit.field_sources') }}</template>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-rows-add>{{ 'anime_edit.add_button'|trans }}</button>
            </div>

            <div class="mb-3" data-control="cover-size-limit">
                <label for="anime-edit-cover" class="form-label">{{ 'anime_edit.field_cover'|trans }}</label>
                {% if cover %}
                    <div class="mb-2"><img src="app-media://anime/{{ anime.id }}/{{ cover }}" alt="{{ anime.title }}" class="anime-edit__cover"></div>
                {% endif %}
                <input type="file" id="anime-edit-cover" name="cover" data-max-bytes="{{ cover_max_bytes }}" data-too-large-message="{{ 'anime_edit.error_cover_too_large'|trans }}" accept="image/png,image/jpeg,image/webp" class="form-control{% if errors.cover is defined %} is-invalid{% endif %}">
                <div class="form-text">{{ 'anime_edit.cover_hint'|trans({'%size%': (cover_max_bytes / 1048576)|round}) }}</div>
                <div class="invalid-feedback" data-cover-error{% if errors.cover is not defined %} hidden{% endif %}>{% if errors.cover is defined %}{{ errors.cover|trans }}{% endif %}</div>
                {% if cover %}
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="anime-edit-cover-remove" name="cover_remove" value="1"{% if form.cover_remove %} checked{% endif %}>
                        <label class="form-check-label" for="anime-edit-cover-remove">{{ 'anime_edit.cover_remove'|trans }}</label>
                    </div>
                {% endif %}
            </div>

            <div class="mb-3">
                <label for="anime-edit-notes" class="form-label">{{ 'anime_edit.field_notes'|trans }}</label>
                <textarea id="anime-edit-notes" name="notes" rows="4" class="form-control">{{ form.notes }}</textarea>
            </div>

            <button type="submit" class="btn btn-primary">{{ 'anime_edit.save_button'|trans }}</button>
            <a href="{{ path('anime_show', {id: anime.id}) }}" class="btn btn-outline-secondary">{{ 'anime_edit.cancel_button'|trans }}</a>
        </form>
    </main>
{% endblock %}
