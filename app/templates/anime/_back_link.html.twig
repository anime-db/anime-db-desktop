 #
 # The "back" link shared by the entry page and the edit page: an arrow icon plus the label.
 # Expects: url (string), label (string); optional: inline (bool, true when rendered inside a
 # container that already has its own padding), catalog_control (bool, mounts the catalog-back-link control).
 #}
<div class="anime-detail__back{% if inline|default(false) %} anime-detail__back--inline{% endif %}">
    <a href="{{ url }}" class="anime-detail__back-link"{% if catalog_control|default(false) %} data-control="catalog-back-link"{% endif %}>
        {{- icon('arrow-left') }} <span>{{ label }}</span>
    </a>
</div>
