{% extends 'base.html.twig' %}

{% block title %}{{ 'anime_new.title'|trans }}{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>{{ 'anime_new.heading'|trans }}</h1>

        {% if error %}
            <p class="alert alert-danger">{{ error|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('anime_create') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('anime_new') }}">
            {% if storage_id is not null %}
                <input type="hidden" name="storage_id" value="{{ storage_id }}">
            {% endif %}
            {% if storage_path is not null %}
                <input type="hidden" name="storage_path" value="{{ storage_path }}">
            {% endif %}

            <div class="mb-3">
                <label for="anime-new-title" class="form-label">{{ 'anime_new.field_title'|trans }}</label>
                <input type="text" id="anime-new-title" name="title" value="{{ title }}" required class="form-control">
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="anime-new-type" class="form-label">{{ 'anime_new.field_type'|trans }}</label>
                    <select id="anime-new-type" name="type" required aria-describedby="anime-new-type-hint" class="form-select">
                        <option value=""{% if type is empty %} selected{% endif %} disabled>{{ 'anime_new.type_placeholder'|trans }}</option>
                        {% for value in types %}
                            <option value="{{ value }}"{% if value == type %} selected{% endif %}>{{ ('anime_type.' ~ value)|trans }}</option>
                        {% endfor %}
                    </select>
                    <div id="anime-new-type-hint" class="form-text">{{ 'anime_new.type_hint'|trans }}</div>
                </div>

                <div class="col-md-6">
                    <label for="anime-new-watch-status" class="form-label">{{ 'anime_new.field_watch_status'|trans }}</label>
                    <select id="anime-new-watch-status" name="watch_status" class="form-select">
                        {% for value in watch_statuses %}
                            <option value="{{ value }}"{% if value == watch_status %} selected{% endif %}>{{ ('watch_status.' ~ value)|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">{{ 'anime_new.submit_button'|trans }}</button>
                <a href="{{ path('home_index') }}" class="btn btn-outline-secondary">{{ 'anime_new.cancel_button'|trans }}</a>
            </div>
        </form>
    </main>
{% endblock %}
