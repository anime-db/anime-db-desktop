{#
 # Text of the confirmation dialog of the "Delete" action (issue #916), shared by the entry card and the
 # "requires attention" page so both warn about the same consequences: only the catalog entry goes; the
 # sentence about files appears for an entry linked to a storage, the one about torrents for an entry with
 # a Completed or Failed download.
 #}
{% macro delete_confirm(title, has_storage, has_finished_downloads) -%}
    {{ 'anime_delete.confirm'|trans({'%title%': bidi_isolate(title)}) }}
    {%- if has_storage %} {{ 'anime_delete.confirm_storage'|trans }}{% endif %}
    {%- if has_finished_downloads %} {{ 'anime_delete.confirm_downloads'|trans }}{% endif %}
{%- endmacro %}
