{#
 # The "fill from source" button/dropdown shared by every card fragment that has a fillable field
 # (_info, _names, _media, _gallery). The form targets the fragment the field lives in (issue #913),
 # so the response replaces just that fragment and a fill error lands next to the button that
 # caused it.
 #}
{% macro fill_button(anime, field, plugins) %}
    {% if plugins is not empty %}
        {% set targets = {alternativeNames: 'anime-names-', cover: 'anime-media-', images: 'anime-gallery-'} %}
        <form class="anime-detail__fill-form"
              hx-post="{{ path('anime_fill_field', {id: anime.id, field: field}) }}"
              hx-target="#{{ targets[field]|default('anime-info-') ~ anime.id }}" hx-swap="outerHTML" hx-disabled-elt="find button">
            <input type="hidden" name="_token" value="{{ csrf_token('anime_fill_' ~ field ~ '_' ~ anime.id) }}">
            {% if plugins|length > 1 %}
                <select name="plugin_id" class="anime-detail__fill-select" aria-label="{{ 'anime_detail.fill_source_label'|trans }}">
                    {% for plugin in plugins %}
                        <option value="{{ plugin.id }}">{{ plugin.name }}</option>
                    {% endfor %}
                </select>
            {% else %}
                <input type="hidden" name="plugin_id" value="{{ plugins[0].id }}">
            {% endif %}
            <button
                type="submit"
                class="anime-detail__fill-button"
                title="{{ 'anime_detail.fill_from_source_button'|trans }}"
            >{{ 'anime_detail.fill_from_source_button'|trans }}</button>
        </form>
    {% endif %}
{% endmacro %}
