{#
 # Rendered both by anime/show.html.twig (initial load, editing = null) and by every
 # AnimeEditableController action (HTMX fragment swap, issue #103). "editing" names the
 # single field currently shown as a form instead of its read-only value; it is always
 # null on the initial full-page load, so watch_statuses/csrf_token() for the "*_edit"
 # forms below are never evaluated there.
 #}
<section class="anime-detail__editable" id="anime-editable-{{ anime.id }}"{% if oob|default(false) %} hx-swap-oob="outerHTML"{% endif %}>
    <h2 class="anime-detail__section-heading">{{ 'anime_detail.my_heading'|trans }}</h2>

    {% if error %}
        <p class="anime-detail__editable-error">{{ error|trans }}</p>
    {% endif %}

    <dl class="anime-detail__fields">
        {% if anime.is_series %}
            <dt>{{ 'anime_detail.field_progress'|trans }}</dt>
            <dd class="anime-detail__progress">
                {% if editing == 'watched_episodes' %}
                    <form class="anime-detail__inline-form"
                          hx-post="{{ path('anime_editable_update_watched_episodes', {id: anime.id}) }}"
                          hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML">
                        <input type="hidden" name="_token" value="{{ csrf_token('anime_editable_watched_episodes_' ~ anime.id) }}">
                        <input
                            type="number"
                            name="watched_episodes"
                            min="0"
                            {%- if anime.episodes_count is not null %} max="{{ anime.episodes_count }}"{% endif %}
                            value="{{ anime.watched_episodes ?: 0 }}"
                        >
                        <span>/ {{ anime.episodes_count ?: '?' }}</span>
                        <button type="submit" class="btn btn-sm btn-primary">{{ 'anime_detail.save_button'|trans }}</button>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            hx-get="{{ path('anime_editable_view', {id: anime.id}) }}"
                            hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML"
                        >{{ 'anime_detail.cancel_button'|trans }}</button>
                    </form>
                {% else %}
                    <button
                        type="button"
                        class="anime-detail__editable-value anime-detail__progress-count"
                        hx-get="{{ path('anime_editable_edit', {id: anime.id, field: 'watched_episodes'}) }}"
                        hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML"
                    >{{ anime.watched_episodes ?: 0 }} / {{ anime.episodes_count ?: '?' }}</button>

                    {% if anime.episodes_count is null or (anime.watched_episodes ?: 0) < anime.episodes_count %}
                        <form class="anime-detail__progress-increment-form"
                              hx-post="{{ path('anime_editable_increment_watched_episodes', {id: anime.id}) }}"
                              hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('anime_editable_increment_watched_episodes_' ~ anime.id) }}">
                            <button
                                type="submit"
                                class="anime-detail__progress-increment"
                                title="{{ 'anime_detail.increment_episode_button'|trans }}"
                            >{{ icon('plus-lg') }}</button>
                        </form>
                    {% endif %}
                {% endif %}
            </dd>
        {% endif %}

        <dt>{{ 'anime_detail.field_watch_status'|trans }}</dt>
        <dd>
            {% if editing == 'watch_status' %}
                <form class="anime-detail__inline-form"
                      hx-post="{{ path('anime_editable_update_watch_status', {id: anime.id}) }}"
                      hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML">
                    <input type="hidden" name="_token" value="{{ csrf_token('anime_editable_watch_status_' ~ anime.id) }}">
                    <select name="watch_status">
                        {% for status in watch_statuses %}
                            <option
                                value="{{ status }}"
                                {%- if status == anime.watch_status %} selected{% endif %}
                                {%- if status == 'completed' and anime.production_status != 'released' %} disabled{% endif %}
                            >{{ ('watch_status.' ~ status)|trans }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">{{ 'anime_detail.save_button'|trans }}</button>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                        hx-get="{{ path('anime_editable_view', {id: anime.id}) }}"
                        hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML"
                    >{{ 'anime_detail.cancel_button'|trans }}</button>
                </form>
            {% else %}
                <button
                    type="button"
                    class="anime-detail__editable-value anime-detail__watch-status-badge anime-detail__watch-status-badge--{{ anime.watch_status }}"
                    hx-get="{{ path('anime_editable_edit', {id: anime.id, field: 'watch_status'}) }}"
                    hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML"
                >{{ ('watch_status.' ~ anime.watch_status)|trans }}</button>
            {% endif %}
        </dd>

        <dt id="anime-rating-label-{{ anime.id }}">{{ 'anime_detail.field_user_rating'|trans }}</dt>
        {#
         # Five toggle buttons, not a radio group: a radio cannot be unset by clicking it again, and
         # clicking the current star clears the rating (it posts an empty value). Each star is its
         # own tiny form so a click, Enter or Space commits - arrow keys do nothing, since every
         # commit re-renders the whole fragment. The stars carry stable ids: HTMX puts focus back on
         # the element with the same id after the swap.
         #}
        <dd>
            <div class="anime-detail__rating" role="group" aria-labelledby="anime-rating-label-{{ anime.id }}">
                {% for value in 1..5 %}
                    <form class="anime-detail__rating-form"
                          hx-post="{{ path('anime_editable_update_user_rating', {id: anime.id}) }}"
                          hx-target="#anime-editable-{{ anime.id }}" hx-swap="outerHTML">
                        <input type="hidden" name="_token" value="{{ csrf_token('anime_editable_user_rating_' ~ anime.id) }}">
                        <input type="hidden" name="user_rating" value="{{ value == anime.user_rating ? '' : value }}">
                        <button
                            type="submit"
                            id="anime-rating-star-{{ anime.id }}-{{ value }}"
                            class="anime-detail__star{% if anime.user_rating is not null and value <= anime.user_rating %} anime-detail__star--on{% endif %}"
                            aria-pressed="{{ value == anime.user_rating ? 'true' : 'false' }}"
                            aria-label="{{ 'anime_detail.rating_star_label'|trans({'%rating%': value}) }}"
                        >{{ icon('star-fill') }}</button>
                    </form>
                {% endfor %}
            </div>
        </dd>
    </dl>

    {% if anime.notes is empty %}
        <button
            type="button"
            class="anime-detail__notes-add btn btn-sm btn-outline-secondary"
            hx-get="{{ path('anime_editable_edit', {id: anime.id, field: 'notes'}) }}"
            hx-target="#anime-notes-{{ anime.id }}" hx-swap="outerHTML"
        >{{ 'anime_detail.notes_add_button'|trans }}</button>
    {% endif %}
</section>
