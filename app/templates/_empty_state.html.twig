 #
 # Empty state: icon + text + optional explanation and action.
 # Expects: icon (string, a name from templates/icons/), text (string); optional: hint (string),
 # action_url (string) with action_label (string).
 #}
<div class="empty-state text-body-secondary">
    <span class="empty-state__icon">{{ icon(icon) }}</span>
    <p class="empty-state__text mb-0">{{ text }}</p>
    {% if hint|default(null) %}
        <p class="empty-state__hint mb-0">{{ hint }}</p>
    {% endif %}
    {% if action_url|default(null) %}
        <a class="btn btn-sm btn-outline-secondary" href="{{ action_url }}">{{ action_label }}</a>
    {% endif %}
</div>
