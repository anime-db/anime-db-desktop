{#
 # The top-nav "Add" menu's "Scan" section (issue #834): app/assets/js/nav-add-menu.js replaces
 # base.html.twig's placeholder `<li>` with this fragment's own `<li>` elements wholesale (it
 # reads this fragment's root as a sibling list, not a single wrapper), so every top-level node
 # here must be an `<li>` of its own.
 #}
{% for storage in connectedStorages %}
    <li>
        <form method="post" action="{{ path('storage_scan', {id: storage.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('storage_scan_' ~ storage.id) }}">
            <button type="submit" class="dropdown-item">{{ 'nav.add_menu_scan_item'|trans({'%name%': bidi_isolate(storage.name)}) }}</button>
        </form>
    </li>
{% endfor %}

{% if disconnectedCount > 0 %}
    <li><a class="dropdown-item" href="{{ path('storage_index') }}">{{ 'nav.add_menu_scan_more'|trans({'%number%': disconnectedCount}) }}</a></li>
{% endif %}

{% if not hasScannableStorages %}
    <li><a class="dropdown-item" href="{{ path('storage_new') }}">{{ 'nav.add_menu_add_storage'|trans }}</a></li>
{% endif %}
