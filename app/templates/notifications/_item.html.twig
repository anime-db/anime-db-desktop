{# One notification of the history: `item` is built by NotificationController. A record with no
   living subject has no url and is shown as plain text from the stored params. #}
<li class="notification-item notification-item--{{ item.severity }}{% if not item.read %} notification-item--unread{% endif %}" data-notification-id="{{ item.id }}"{% if not item.read %} data-notification-unread{% endif %}>
    <div class="notification-item__title">
        {%- if not item.read %}<span class="visually-hidden">{{ 'notification_list.unread_marker'|trans }}</span>{% endif -%}
        {%- if item.url is not null %}<a href="{{ item.url }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif -%}
    </div>
    {% if item.body is not empty %}<div class="notification-item__body">{{ item.body }}</div>{% endif %}
    <time class="notification-item__time" datetime="{{ item.occurredAt|date('c') }}">{{ item.occurredAt|date('Y-m-d H:i') }}</time>
</li>
