{% extends 'base.html.twig' %}

{% block title %}{{ 'notification_list.page_title'|trans }}{% endblock %}

{% block body %}
    <main class="container py-3 notification-history">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h1 class="h4 mb-0">{{ 'notification_list.page_title'|trans }}</h1>
            <form method="post" action="{{ path('notifications_read_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('notifications') }}">
                <button type="submit" class="btn btn-outline-secondary btn-sm">{{ 'notification_list.read_all'|trans }}</button>
            </form>
        </div>
        {% if items is empty %}
            <p class="text-body-secondary">{{ 'notification_list.empty'|trans }}</p>
        {% else %}
            <ul class="notification-list list-unstyled">
                {% for item in items %}
                    {% include 'notifications/_item.html.twig' %}
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
