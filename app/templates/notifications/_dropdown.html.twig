{# The body of the header bell's dropdown, fetched when the menu is opened. #}
<div class="notification-dropdown__head">
    <span class="fw-semibold">{{ 'notification_list.title'|trans }}</span>
    <button type="button" class="btn btn-link btn-sm p-0" data-bell-read-all>{{ 'notification_list.read_all'|trans }}</button>
</div>
{% if items is empty %}
    <p class="notification-dropdown__empty">{{ 'notification_list.empty'|trans }}</p>
{% else %}
    <ul class="notification-list list-unstyled mb-0">
        {% for item in items %}
            {% include 'notifications/_item.html.twig' %}
        {% endfor %}
    </ul>
{% endif %}
<div class="notification-dropdown__foot">
    <a href="{{ path('notifications_index') }}">{{ 'notification_list.show_all'|trans }}</a>
</div>
