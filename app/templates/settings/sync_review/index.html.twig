{% extends 'base.html.twig' %}

{% block title %}{{ 'settings_sync_review.title'|trans }}{% endblock %}

{% block body %}
    <p><a href="{{ path('settings_index') }}">{{ 'settings_sync_review.back_link'|trans }}</a></p>
    <h1>{{ 'settings_sync_review.heading'|trans }}</h1>

    {% if items is empty %}
        <p>{{ 'settings_sync_review.empty'|trans }}</p>
    {% else %}
        <ul>
            {% for item in items %}
                <li>
                    {% if duplicateClusters[item.id] is not empty %}
                        <p>{{ 'settings_sync_review.kind_potential_duplicate'|trans }}</p>
                        <ul>
                            {% for anime in duplicateClusters[item.id] %}
                                <li><a href="{{ path('anime_show', {id: anime.id}) }}">{{ anime.title }}</a></li>
                            {% endfor %}
                        </ul>
                    {% elseif deletionDetails[item.id] is defined %}
                        {% set detail = deletionDetails[item.id] %}
                        {% if item.kind.value == 'deletion_conflict' %}
                            <p>{{ 'settings_sync_review.kind_deletion_conflict'|trans({'%source%': detail.deletedFrom, '%others%': detail.stillPresentOn|join(', ')}) }}</p>
                        {% else %}
                            <p>{{ 'settings_sync_review.kind_deleted_from_source'|trans({'%source%': detail.deletedFrom}) }}</p>
                        {% endif %}
                        {% if detail.anime is not null %}
                            <a href="{{ path('anime_show', {id: detail.anime.id}) }}">{{ detail.anime.title }}</a>
                        {% endif %}
                    {% endif %}

                    <form method="post" action="{{ path('settings_sync_review_resolve', {id: item.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('settings_sync_review_resolve_' ~ item.id) }}">
                        <button type="submit">{{ 'settings_sync_review.resolve_button'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
