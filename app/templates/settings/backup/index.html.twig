{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'settings_backup.title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="py-4" data-control="settings-backup">
        <h1>{{ 'settings_backup.heading'|trans }}</h1>

        <p id="settings-backup-unavailable" class="alert alert-warning" hidden>{{ 'settings_backup.unavailable_outside_app'|trans }}</p>

        {% if stagedImport %}
            <div id="settings-backup-staged-import-banner" class="alert alert-info d-flex justify-content-between align-items-center gap-3">
                <span>{{ 'settings_backup.staged_import_banner'|trans({'%date%': stagedImport.stagedAt|date('Y-m-d H:i'), '%name%': stagedImport.sourceArchive}) }}</span>
                <form method="post" action="{{ path('settings_backup_import_cancel') }}" class="m-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('settings_backup_import_cancel') }}">
                    <button type="submit" class="btn btn-outline-danger text-nowrap">{{ 'settings_backup.staged_import_cancel_button'|trans }}</button>
                </form>
            </div>
        {% elseif stagedImportRejectionReason %}
            <div id="settings-backup-staged-import-rejected-banner" class="alert alert-warning">
                {{ ('settings_backup.staged_import_rejected_banner_' ~ stagedImportRejectionReason)|trans }}
            </div>
        {% endif %}

        {% if importedPlugins is not empty %}
            <section id="settings-backup-imported-plugins-section">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <h2>{{ 'settings_backup.import_plugins_heading'|trans }}</h2>
                    <form method="post" action="{{ path('settings_backup_import_plugins_dismiss') }}" class="m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('settings_backup_import_plugins_dismiss') }}">
                        <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">{{ 'settings_backup.import_plugins_dismiss_button'|trans }}</button>
                    </form>
                </div>
                <p class="text-body-secondary">{{ 'settings_backup.import_plugins_description'|trans }}</p>
                <ul id="settings-backup-imported-plugins-list" class="list-group">
                    {% for plugin in importedPlugins %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <span>{{ plugin.displayName }}</span>
                            <span class="badge text-bg-secondary">{{ ('settings_backup.import_plugin_status_' ~ plugin.status.value)|trans }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <hr class="my-4">
        {% endif %}

        <section id="settings-backup-export-section">
            <h2>{{ 'settings_backup.export_heading'|trans }}</h2>
            <p class="text-body-secondary">{{ 'settings_backup.description'|trans }}</p>

            <div id="settings-backup-form">
                <div class="mb-3">
                    <label for="settings-backup-path" class="form-label">{{ 'settings_backup.destination_label'|trans }}</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="settings-backup-path" readonly class="form-control">
                        <button type="button" id="settings-backup-pick-folder" class="btn btn-outline-secondary text-nowrap">{{ 'settings_backup.pick_folder_button'|trans }}</button>
                    </div>
                </div>

                <button type="button" id="settings-backup-start" class="btn btn-primary" disabled>{{ 'settings_backup.start_button'|trans }}</button>
                <button type="button" id="settings-backup-cancel" class="btn btn-outline-danger" hidden>{{ 'settings_backup.cancel_button'|trans }}</button>
            </div>

            <div id="settings-backup-progress" class="mt-3" hidden>
                <div class="progress">
                    <div class="progress-bar" id="settings-backup-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span id="settings-backup-progress-text"></span>
            </div>

            <p id="settings-backup-result" class="alert alert-success mt-3" hidden></p>
            <p id="settings-backup-error" class="alert alert-danger mt-3" hidden></p>
        </section>

        <hr class="my-4">

        <section id="settings-backup-import-section">
            <h2>{{ 'settings_backup.import_heading'|trans }}</h2>
            <p class="text-body-secondary">{{ 'settings_backup.import_description'|trans }}</p>

            <div id="settings-import-form">
                <div class="mb-3">
                    <label for="settings-import-path" class="form-label">{{ 'settings_backup.import_path_label'|trans }}</label>
                    <div class="d-flex gap-2">
                        <input type="text" id="settings-import-path" readonly class="form-control">
                        <button type="button" id="settings-import-pick-file" class="btn btn-outline-secondary text-nowrap">{{ 'settings_backup.import_pick_button'|trans }}</button>
                    </div>
                </div>

                <button type="button" id="settings-import-start" class="btn btn-danger" disabled>{{ 'settings_backup.import_start_button'|trans }}</button>
            </div>

            <div id="settings-import-progress" class="mt-3" hidden>
                <div class="progress">
                    <div class="progress-bar" id="settings-import-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span id="settings-import-progress-text"></span>
            </div>

            <p id="settings-import-result" class="alert alert-success mt-3" hidden></p>
            <p id="settings-import-error" class="alert alert-danger mt-3" hidden></p>
        </section>

        <hr class="my-4">

        <section id="settings-backup-snapshots-section">
            <h2>{{ 'settings_backup.snapshots_heading'|trans }}</h2>
            <p class="text-body-secondary">{{ 'settings_backup.snapshots_description'|trans }}</p>

            <p id="settings-backup-snapshots-error" class="alert alert-danger" hidden></p>

            {% if backups is empty %}
                <p id="settings-backup-snapshots-empty" class="text-body-secondary">{{ 'settings_backup.snapshots_empty'|trans }}</p>
            {% else %}
                <ul id="settings-backup-snapshots-list" class="list-group">
                    {% for backup in backups %}
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <span>
                                {{ backup.createdAt|date('Y-m-d H:i:s') }}
                                &middot;
                                {% if backup.sizeBytes >= 1024 * 1024 %}
                                    {{ (backup.sizeBytes / (1024 * 1024))|round(1) }}&nbsp;{{ 'settings_backup.snapshot_size_unit_mb'|trans }}
                                {% else %}
                                    {{ (backup.sizeBytes / 1024)|round(1) }}&nbsp;{{ 'settings_backup.snapshot_size_unit_kb'|trans }}
                                {% endif %}
                                {% if backup.isPreImport %}
                                    <span class="badge text-bg-info">{{ 'settings_backup.snapshot_preimport_badge'|trans }}</span>
                                {% endif %}
                            </span>
                            <button
                                type="button"
                                class="btn btn-outline-danger settings-backup-restore-button text-nowrap"
                                data-backup-name="{{ backup.name }}"
                            >{{ 'settings_backup.snapshot_restore_button'|trans }}</button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </main>
{% endblock %}
