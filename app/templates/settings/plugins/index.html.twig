{% extends 'base.html.twig' %}

{% block title %}{{ 'settings_plugins.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <a href="{{ path('settings_index') }}" class="btn btn-outline-secondary btn-sm mb-3">{{ 'settings_plugins.back_link'|trans }}</a>
        <h1>{{ 'settings_plugins.heading'|trans }}</h1>

        <p><a href="{{ path('settings_plugin_widgets_index') }}" class="btn btn-outline-secondary btn-sm">{{ 'settings_plugins.widgets_link'|trans }}</a></p>

        {% if installedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.install_success'|trans({'%pluginId%': installedPluginId}) }}</p>
        {% endif %}

        {% if updatedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.update_success'|trans({'%pluginId%': updatedPluginId}) }}</p>
        {% endif %}

        {% if removedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.remove_success'|trans({'%pluginId%': removedPluginId}) }}</p>
        {% endif %}

        {% if installError is not null %}
            <p class="alert alert-danger">{{ installError|trans(installErrorParams) }}</p>

            {% if syntaxErrors is not empty %}
                <ul class="settings-plugins__error-list">
                    {% for syntaxError in syntaxErrors %}
                        <li>{{ syntaxError.relativePath }}: {{ syntaxError.message }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if manifestErrors is not empty %}
                <ul class="settings-plugins__error-list">
                    {% for manifestError in manifestErrors %}
                        <li>{{ manifestError.field }}: {{ manifestError.message }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        {% endif %}

        <h2>{{ 'settings_plugins.installed_heading'|trans }}</h2>

        {% if installedPlugins is empty %}
            <p class="text-body-secondary">{{ 'settings_plugins.installed_empty'|trans }}</p>
        {% else %}
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ 'settings_plugins.name_column'|trans }}</th>
                        <th>{{ 'settings_plugins.id_column'|trans }}</th>
                        <th>{{ 'settings_plugins.version_column'|trans }}</th>
                        <th>{{ 'settings_plugins.type_column'|trans }}</th>
                        <th>{{ 'settings_plugins.status_column'|trans }}</th>
                        <th>{{ 'settings_plugins.languages_column'|trans }}</th>
                        <th>{{ 'settings_plugins.translation_coverage_column'|trans }}</th>
                        <th>{{ 'settings_plugins.actions_column'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for plugin in installedPlugins %}
                        <tr>
                            <td>{{ plugin.manifest.name }}</td>
                            <td><code>{{ plugin.id }}</code></td>
                            <td>{{ plugin.manifest.version }}</td>
                            <td>{{ ('plugin_type.' ~ plugin.manifest.type.value)|trans }}</td>
                            <td>
                                {% if not plugin.compatible %}
                                    <span class="badge text-bg-danger">{{ 'settings_plugins.status_incompatible'|trans }}</span>
                                {% elseif plugin.enabled %}
                                    <span class="badge text-bg-success">{{ 'settings_plugins.status_enabled'|trans }}</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ 'settings_plugins.status_disabled'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if pluginLocales[plugin.id ~ ''] is defined %}
                                    <ul class="settings-plugins__locales-list list-unstyled mb-0">
                                        {% for locale in pluginLocales[plugin.id ~ ''].locales %}
                                            <li>{{ locale }}</li>
                                        {% endfor %}
                                    </ul>
                                    {% if pluginLocales[plugin.id ~ ''].missingFallbackLocale %}
                                        <p class="settings-plugins__missing-fallback-locale text-warning-emphasis small mb-0">{{ 'settings_plugins.missing_fallback_locale'|trans }}</p>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {% if translationCoverage[plugin.id ~ ''] is defined %}
                                    <ul class="settings-plugins__coverage-list list-unstyled mb-0">
                                        {% for locale, coverage in translationCoverage[plugin.id ~ ''] %}
                                            <li>{{ 'settings_plugins.translation_coverage_badge'|trans({'%locale%': locale, '%covered%': coverage.covered, '%total%': coverage.total}) }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                            <td>
                                {% if (plugin.id ~ '') in settingsPluginIds %}
                                    <a href="{{ path('settings_plugin_page', {pluginId: plugin.id}) }}" class="btn btn-outline-secondary btn-sm me-2">{{ 'settings_plugins.settings_link'|trans }}</a>
                                {% endif %}
                                <form method="post" action="{{ path('settings_plugins_remove', {pluginId: plugin.id}) }}" class="settings-plugins__remove-form d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_plugins_remove_' ~ plugin.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'settings_plugins.remove_button'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <h2 class="mt-4">{{ 'settings_plugins.install_heading'|trans }}</h2>

        <form method="post" action="{{ path('settings_plugins_install') }}" enctype="multipart/form-data" id="plugin-install-form">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_plugins_install') }}">

            <div class="mb-3">
                <label for="plugin-install-file" class="form-label">{{ 'settings_plugins.install_file_label'|trans }}</label>
                <input type="file" id="plugin-install-file" name="plugin_zip" accept=".zip" required class="form-control">
            </div>

            <p class="alert alert-danger" id="plugin-install-client-error" hidden></p>

            <div class="settings-plugins__warning alert alert-warning" id="plugin-install-warning" hidden>
                <p>{{ 'settings_plugins.third_party_warning'|trans }}</p>
                <button type="button" id="plugin-install-confirm-button" class="btn btn-warning btn-sm">{{ 'settings_plugins.confirm_button'|trans }}</button>
            </div>

            <button type="submit" id="plugin-install-submit-button" class="btn btn-primary" disabled>{{ 'settings_plugins.install_button'|trans }}</button>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/plugin-install.js') }}"></script>
{% endblock %}
