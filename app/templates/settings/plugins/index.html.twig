{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'settings_plugins.title'|trans }}{% endblock %}

{% block settings_content %}
    <div class="py-4">
        <h1 class="mb-4">{{ 'settings_plugins.installed_heading'|trans }}</h1>

        {% if error == 'busy_retry' %}
            <p class="alert alert-danger">{{ 'settings_plugins.busy_retry_error'|trans }}</p>
        {% endif %}

        {% if installedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.install_success'|trans({'%pluginId%': installedPluginId}) }}</p>
        {% endif %}

        {% if updatedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.update_success'|trans({'%pluginId%': updatedPluginId}) }}</p>
        {% endif %}

        {% if removedPluginId is not null %}
            <p class="alert alert-success">{{ 'settings_plugins.remove_success'|trans({'%pluginId%': removedPluginId}) }}</p>
        {% endif %}

        {% if installedPlugins is empty %}
            {{ include('_empty_state.html.twig', {
                icon: 'download',
                text: 'settings_plugins.installed_empty'|trans,
                action_url: path('settings_market_index'),
                action_label: 'settings_plugins.open_market_link'|trans
            }) }}
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'settings_plugins.name_column'|trans }}</th>
                            <th>{{ 'settings_plugins.id_column'|trans }}</th>
                            <th>{{ 'settings_plugins.version_column'|trans }}</th>
                            <th>{{ 'settings_plugins.type_column'|trans }}</th>
                            <th>{{ 'settings_plugins.status_column'|trans }}</th>
                            <th>{{ 'settings_plugins.languages_column'|trans }}</th>
                            <th>{{ 'settings_plugins.translation_coverage_column'|trans }}</th>
                            <th>{{ 'settings_plugins.actions_column'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for plugin in installedPlugins %}
                            <tr>
                                <td>{{ plugin.manifest.name }}</td>
                                <td><code>{{ plugin.id }}</code></td>
                                <td>{{ plugin.manifest.version }}</td>
                                <td>{{ ('plugin_type.' ~ plugin.manifest.type.value)|trans }}</td>
                                <td>
                                    {% if not plugin.compatible %}
                                        <span class="badge text-bg-danger">{{ 'settings_plugins.status_incompatible_badge'|trans }}</span>
                                        <div class="small text-body-secondary mt-1">{{ 'settings_plugins.status_incompatible'|trans }}</div>
                                        <div class="small mt-1">
                                            <a href="{{ path('settings_market_index') }}">
                                                {%- if marketUpdates[plugin.id ~ ''] is defined -%}
                                                    {{ 'settings_plugins.incompatible_market_update'|trans({'%version%': marketUpdates[plugin.id ~ '']}) }}
                                                {%- else -%}
                                                    {{ 'settings_plugins.incompatible_market_link'|trans }}
                                                {%- endif -%}
                                            </a>
                                        </div>
                                    {% elseif plugin.enabled %}
                                        <span class="badge text-bg-success">{{ 'settings_plugins.status_enabled'|trans }}</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary">{{ 'settings_plugins.status_disabled'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if pluginLocales[plugin.id ~ ''] is defined %}
                                        <ul class="list-unstyled mb-0">
                                            {% for locale in pluginLocales[plugin.id ~ ''].locales %}
                                                <li>{{ locale }}</li>
                                            {% endfor %}
                                        </ul>
                                        {% if pluginLocales[plugin.id ~ ''].missingFallbackLocale %}
                                            <p class="text-warning-emphasis small mb-0">{{ 'settings_plugins.missing_fallback_locale'|trans }}</p>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if translationCoverage[plugin.id ~ ''] is defined %}
                                        <ul class="list-unstyled mb-0">
                                            {% for locale, coverage in translationCoverage[plugin.id ~ ''] %}
                                                <li>{{ 'settings_plugins.translation_coverage_badge'|trans({'%locale%': locale, '%covered%': coverage.covered, '%total%': coverage.total}) }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center flex-nowrap">
                                        {% if (plugin.id ~ '') in settingsPluginIds %}
                                            <a href="{{ path('settings_plugin_page', {pluginId: plugin.id}) }}" class="btn btn-outline-secondary btn-sm btn-icon" title="{{ 'settings_plugins.settings_link'|trans }}" aria-label="{{ 'settings_plugins.settings_link'|trans }}">
                                                {{ icon('gear') }}
                                            </a>
                                        {% endif %}
                                        {% if (plugin.id ~ '') in syncPluginIds %}
                                            {% set syncActive = (plugin.id ~ '') in syncActiveIds %}
                                            <form method="post" action="{{ path('settings_plugins_sync_toggle', {pluginId: plugin.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('settings_plugin_sync_toggle_' ~ plugin.id) }}">
                                                <input type="hidden" name="active" value="{{ syncActive ? '0' : '1' }}">
                                                <button type="submit" class="btn btn-sm {{ syncActive ? 'btn-success' : 'btn-outline-secondary' }}" role="switch" aria-checked="{{ syncActive ? 'true' : 'false' }}" data-sync-toggle>
                                                    {{ 'settings_plugins.sync_toggle'|trans }}: {{ (syncActive ? 'settings_plugins.sync_on' : 'settings_plugins.sync_off')|trans }}
                                                </button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('settings_plugins_remove', {pluginId: plugin.id}) }}" data-confirm="{{ 'settings_plugins.remove_confirm'|trans({'%name%': bidi_isolate(plugin.manifest.name)}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('settings_plugins_remove_' ~ plugin.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-icon" title="{{ 'settings_plugins.remove_button'|trans }}" aria-label="{{ 'settings_plugins.remove_button'|trans }}">
                                                {{ icon('trash') }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
