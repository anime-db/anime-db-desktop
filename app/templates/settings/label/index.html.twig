{% extends 'base.html.twig' %}

{% block title %}{{ 'settings_labels.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">
        <a href="{{ path('settings_index') }}" class="btn btn-outline-secondary btn-sm mb-3">{{ 'settings_labels.back_link'|trans }}</a>
        <h1>{{ 'settings_labels.heading'|trans }}</h1>

        {% if error == 'empty_name' %}
            <p class="alert alert-danger">{{ 'settings_labels.empty_name_error'|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('settings_labels_add') }}" class="d-flex gap-2 mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_add') }}">
            <input type="text" name="name" maxlength="32" required placeholder="{{ 'settings_labels.name_placeholder'|trans }}" class="form-control w-auto">
            <button type="submit" class="btn btn-primary">{{ 'settings_labels.add_button'|trans }}</button>
        </form>

        {% if labels is empty %}
            <p class="text-body-secondary">{{ 'settings_labels.empty'|trans }}</p>
        {% else %}
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ 'settings_labels.name_column'|trans }}</th>
                        <th>{{ 'settings_labels.actions_column'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for label in labels %}
                        <tr>
                            <td>
                                <form method="post" action="{{ path('settings_labels_rename', {id: label.id}) }}" class="d-flex gap-2">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_rename_' ~ label.id) }}">
                                    <input type="text" name="name" value="{{ label.name }}" maxlength="32" required class="form-control form-control-sm w-auto">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'settings_labels.save_button'|trans }}</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" action="{{ path('settings_labels_delete', {id: label.id}) }}" data-confirm="{{ 'settings_labels.delete_confirm'|trans({'%name%': bidi_isolate(label.name)}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_delete_' ~ label.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'settings_labels.delete_button'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
