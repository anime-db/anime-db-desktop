{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'settings_labels.title'|trans }}{% endblock %}

{% block settings_content %}
    <div class="py-4">
        <h1 class="mb-4">{{ 'settings_labels.heading'|trans }}</h1>
        <p class="text-body-secondary">{{ 'settings_labels.description'|trans }}</p>

        {% if error == 'empty_name' %}
            <p class="alert alert-danger">{{ 'settings_labels.empty_name_error'|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('settings_labels_add') }}" class="d-flex gap-2 mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_add') }}">
            <input type="text" name="name" maxlength="32" required aria-label="{{ 'settings_labels.new_name_label'|trans }}" placeholder="{{ 'settings_labels.name_placeholder'|trans }}" class="form-control w-auto">
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                {{ icon('plus-lg') }}
                {{ 'settings_labels.add_button'|trans }}
            </button>
        </form>

        {% if labels is empty %}
            <p class="text-body-secondary">{{ 'settings_labels.empty'|trans }}</p>
        {% else %}
            <ul class="list-group">
                {% for label in labels %}
                    {% set count = labelCounts[label.id] %}
                    <li class="list-group-item d-flex align-items-center gap-3">
                        <form method="post" action="{{ path('settings_labels_rename', {id: label.id}) }}"
                              class="settings-label__rename-form d-flex align-items-center gap-2 flex-grow-1"
                              data-control="settings-label-rename">
                            <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_rename_' ~ label.id) }}">
                            <button type="button" class="settings-label__name-button" data-settings-label-name-button hidden>
                                <bdi>{{ label.name }}</bdi>
                            </button>
                            <span class="settings-label__name-input-group" data-settings-label-input-group>
                                <input type="text" name="name" value="{{ label.name }}" maxlength="32" required aria-label="{{ 'settings_labels.rename_label'|trans }}"
                                       class="form-control form-control-sm w-auto" data-settings-label-name-input>
                                <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'settings_labels.save_button'|trans }}</button>
                            </span>
                            <p class="settings-label__name-error text-danger small mb-0" data-settings-label-name-error hidden>{{ 'settings_labels.empty_name_error'|trans }}</p>
                        </form>
                        {% if count > 0 %}
                            <a href="{{ path('home_index', {labels: label.id}) }}" class="settings-label__count" title="{{ 'settings_labels.count_link_title'|trans }}">{{ 'settings_labels.count_label'|trans({'%entries%': count}) }}</a>
                        {% else %}
                            <span class="settings-label__count text-body-secondary">{{ 'settings_labels.count_label'|trans({'%entries%': count}) }}</span>
                        {% endif %}
                        <form method="post" action="{{ path('settings_labels_delete', {id: label.id}) }}"
                              data-confirm="{{ (count > 0 ? 'settings_labels.delete_confirm_with_count' : 'settings_labels.delete_confirm')|trans({'%name%': bidi_isolate(label.name), '%count%': count}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('settings_labels_delete_' ~ label.id) }}">
                            <button type="submit" class="btn btn-outline-secondary btn-sm btn-icon" title="{{ 'settings_labels.delete_button'|trans }}" aria-label="{{ 'settings_labels.delete_button'|trans }}">
                                {{ icon('trash') }}
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
