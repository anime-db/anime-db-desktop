{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'settings.title'|trans }}{% endblock %}

{% block settings_content %}
    <div class="py-4">
        <h1>{{ 'settings.heading'|trans }}</h1>

        <form method="post" action="{{ path('settings_set_locale') }}" class="mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_set_locale') }}">
            <div class="mb-3">
                <label for="locale" class="form-label">{{ 'settings.language_label'|trans }}</label>
                <select id="locale" name="locale" class="form-select" data-submit-on-change>
                    {% if unavailableLocale is not empty %}
                        <option value="" disabled selected>{{ 'settings.language_unavailable_option'|trans({'%language%': locale_endonym(unavailableLocale)}) }}</option>
                    {% endif %}
                    {% for locale in availableLocales %}
                        <option value="{{ locale }}"{% if unavailableLocale is empty and locale == app.request.locale %} selected{% endif %}>{{ locale_endonym(locale) }}</option>
                    {% endfor %}
                </select>
                <div class="form-text">{{ 'settings.language_plugin_translation_note'|trans }}</div>
            </div>
        </form>

        <form method="post" action="{{ path('settings_set_theme') }}" class="mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_set_theme') }}">
            <fieldset class="mb-3">
                <legend class="form-label fs-6">{{ 'settings.theme_label'|trans }}</legend>
                <div class="btn-group" role="group" aria-label="{{ 'settings.theme_label'|trans }}">
                    {% set themeIcons = {system: 'display', light: 'sun', dark: 'moon-stars'} %}
                    {% for option in ['system', 'light', 'dark'] %}
                        <input type="radio" class="btn-check" name="themePreference" id="theme-{{ option }}"
                               value="{{ option }}"{% if themePreference.value == option %} checked{% endif %}
                               autocomplete="off" data-submit-on-change>
                        <label class="btn btn-outline-secondary" for="theme-{{ option }}"
                               title="{{ ('settings.theme_option_' ~ option)|trans }}">
                            {{ icon(themeIcons[option]) }}
                            <span class="visually-hidden">{{ ('settings.theme_option_' ~ option)|trans }}</span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
        </form>

        <form method="post" action="{{ path('settings_set_pagination_mode') }}" class="mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_set_pagination_mode') }}">
            <fieldset class="mb-3">
                <legend class="form-label fs-6">{{ 'settings.pagination_mode_label'|trans }}</legend>
                <div class="btn-group" role="group" aria-label="{{ 'settings.pagination_mode_label'|trans }}">
                    {% for option in ['infinite_scroll', 'classic'] %}
                        <input type="radio" class="btn-check" name="paginationMode" id="pagination-mode-{{ option }}"
                               value="{{ option }}"{% if paginationMode.value == option %} checked{% endif %}
                               autocomplete="off" data-submit-on-change>
                        <label class="btn btn-outline-secondary" for="pagination-mode-{{ option }}">
                            {{ ('settings.pagination_mode_option_' ~ option)|trans }}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
        </form>

    </div>
{% endblock %}
