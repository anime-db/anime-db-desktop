{% extends 'base.html.twig' %}

{% block title %}{{ 'settings.title'|trans({}, null, currentLocale) }}{% endblock %}

{% block body %}
    <h1>{{ 'settings.heading'|trans({}, null, currentLocale) }}</h1>

    <form method="post" action="{{ path('settings_set_locale') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('settings_set_locale') }}">
        <label for="locale">{{ 'settings.language_label'|trans({}, null, currentLocale) }}</label>
        <select id="locale" name="locale" onchange="this.form.submit()">
            {% for locale in availableLocales %}
                <option value="{{ locale }}"{% if locale == currentLocale %} selected{% endif %}>{{ ('settings.locale.'~locale)|trans({}, null, currentLocale) }}</option>
            {% endfor %}
        </select>
    </form>

    <ul>
        <li><a href="{{ path('settings_labels_index') }}">{{ 'settings.labels_link'|trans({}, null, currentLocale) }}</a></li>
        <li><a href="{{ path('settings_plugins_index') }}">{{ 'settings.plugins_link'|trans({}, null, currentLocale) }}</a></li>
        <li><a href="{{ path('settings_plugin_widgets_index') }}">{{ 'settings.plugin_widgets_link'|trans({}, null, currentLocale) }}</a></li>
        <li>
            <a href="{{ path('settings_sync_review_index') }}">{{ 'settings.sync_review_link'|trans({}, null, currentLocale) }}</a>
            {% if needsCorrectionCount > 0 %}
                <span class="settings__badge">{{ 'settings.sync_review_badge'|trans({'%count%': needsCorrectionCount}, null, currentLocale) }}</span>
            {% endif %}
        </li>
        <li><a href="{{ path('settings_proxy_index') }}">{{ 'settings.proxy_link'|trans({}, null, currentLocale) }}</a></li>
    </ul>

    <h2>{{ 'settings.search_reindex_heading'|trans({}, null, currentLocale) }}</h2>

    {% if reindexStatus == 'success' %}
        <p class="success">{{ 'settings.search_reindex_success'|trans({}, null, currentLocale) }}</p>
    {% elseif reindexStatus == 'error' %}
        <p class="error">{{ 'settings.search_reindex_error'|trans({}, null, currentLocale) }}</p>
    {% endif %}

    <form method="post" action="{{ path('settings_search_reindex') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('settings_search_reindex') }}">
        <button type="submit">{{ 'settings.search_reindex_button'|trans({}, null, currentLocale) }}</button>
    </form>
{% endblock %}
