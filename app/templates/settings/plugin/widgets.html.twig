{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'settings_plugin_widgets.title'|trans }}{% endblock %}

{% macro section(placement, widgets, activeCount, hardLimit, recommendedLimit = null) %}
    {% if widgets is empty %}
        <p class="text-body-secondary">{{ ('settings_plugin_widgets.'~placement~'.empty')|trans }}</p>
    {% else %}
        <p class="text-body-secondary">
            {{ 'settings_plugin_widgets.active_count'|trans({'%count%': activeCount, '%limit%': hardLimit}) }}
        </p>
        {% if recommendedLimit is not null and activeCount > recommendedLimit %}
            <p class="alert alert-warning">{{ 'settings_plugin_widgets.recommendation_warning'|trans({'%limit%': recommendedLimit}) }}</p>
        {% endif %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ 'settings_plugin_widgets.plugin_column'|trans }}</th>
                        <th>{{ 'settings_plugin_widgets.widget_column'|trans }}</th>
                        <th>{{ 'settings_plugin_widgets.active_column'|trans }}</th>
                        {% if placement == 'entry' %}<th>{{ 'settings_plugin_widgets.slot_column'|trans }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for widget in widgets %}
                        <tr>
                            <td>{{ widget.pluginName }}</td>
                            <td>
                                <div>{{ widget.title }}</div>
                                {% if widget.description is not empty %}
                                    <div class="text-body-secondary small">{{ widget.description }}</div>
                                {% endif %}
                                <code>{{ widget.widgetName }}</code>
                            </td>
                            <td>
                                <form method="post" action="{{ path('settings_plugin_widgets_toggle', {pluginId: widget.pluginId, widgetName: widget.widgetName}) }}" class="form-check">
                                    <input type="hidden" name="_token" value="{{ csrf_token('settings_plugin_widgets_toggle_'~widget.pluginId~'_'~widget.widgetName) }}">
                                    <input type="hidden" name="placement" value="{{ placement }}">
                                    <input type="hidden" name="active" value="0">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        name="active"
                                        value="1"
                                        data-submit-on-change
                                        {% if widget.active %}checked{% endif %}
                                        {% if not widget.active and activeCount >= hardLimit %}disabled title="{{ 'settings_plugin_widgets.hard_limit_reached'|trans({'%limit%': hardLimit}) }}"{% endif %}
                                    >
                                </form>
                            </td>
                            {% if placement == 'entry' %}
                                <td>
                                    {% if widget.active %}
                                        <form method="post" action="{{ path('settings_plugin_widgets_slot', {pluginId: widget.pluginId, widgetName: widget.widgetName}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('settings_plugin_widgets_slot_'~widget.pluginId~'_'~widget.widgetName) }}">
                                            <select class="form-select form-select-sm" name="slot" data-submit-on-change>
                                                <option value="bottom" {% if widget.slot == 'bottom' %}selected{% endif %}>{{ 'settings_plugin_widgets.slot_bottom'|trans }}</option>
                                                <option value="side" {% if widget.slot == 'side' %}selected{% endif %}>{{ 'settings_plugin_widgets.slot_side'|trans }}</option>
                                            </select>
                                        </form>
                                    {% endif %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endmacro %}

{% block settings_content %}
    <div class="py-4">
        <h1>{{ 'settings_plugin_widgets.heading'|trans }}</h1>

        {% if error == 'hard_limit_exceeded' %}
            <p class="alert alert-danger">{{ 'settings_plugin_widgets.hard_limit_reached'|trans({'%limit%': limitReached}) }}</p>
        {% elseif error == 'busy_retry' %}
            <p class="alert alert-danger">{{ 'settings_plugin_widgets.busy_retry_error'|trans }}</p>
        {% endif %}

        <h2>{{ 'settings_plugin_widgets.entry.heading'|trans }}</h2>
        {{ _self.section('entry', entryWidgets, entryActiveCount, entryHardLimit, recommendedLimit) }}

        <h2 class="mt-4">{{ 'settings_plugin_widgets.catalog.heading'|trans }}</h2>
        {{ _self.section('catalog', catalogWidgets, catalogActiveCount, catalogHardLimit) }}
    </div>
{% endblock %}
