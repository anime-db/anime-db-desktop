{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ pluginName }} — {{ 'settings_plugin_page.title_suffix'|trans }}{% endblock %}

{% block stylesheets %}
    {% for cssUrl in pluginUi.css %}
        <link rel="stylesheet" href="{{ cssUrl }}">
    {% endfor %}
{% endblock %}

{% block javascripts %}
    {% for jsUrl in pluginUi.js %}
        <script src="{{ jsUrl }}" defer></script>
    {% endfor %}
{% endblock %}

{% block settings_content %}
    <div class="py-4">
        <h1>{{ pluginName }}</h1>

        {% if oauthCallbackWarning is defined and oauthCallbackWarning %}
            <p class="alert alert-warning">{{ 'settings_plugin_page.oauth_fixed_port_warning'|trans }}</p>
        {% endif %}

        {% if renderFailed %}
            <p class="alert alert-danger">{{ 'settings_plugin_page.render_error'|trans }}</p>
        {% else %}
            {{ content|raw }}
        {% endif %}
    </div>
{% endblock %}
