{% extends 'base.html.twig' %}

{% block body %}
    <div class="settings-layout">
        <nav class="settings-sidebar" aria-label="{{ 'settings_nav.aria_label'|trans }}">
            {% for group in settings_nav_groups() %}
                <div class="settings-sidebar__group">
                    <div class="settings-sidebar__group-label">{{ group.label }}</div>
                    <ul class="settings-sidebar__items list-unstyled">
                        {% for item in group.items %}
                            <li>
                                <a
                                    class="settings-sidebar__link{% if item.active %} settings-sidebar__link--active{% endif %}"
                                    href="{{ item.url }}"
                                    {%- if item.active %} aria-current="page"{% endif %}
                                >
                                    <span>{{ item.label }}</span>
                                    {% if item.badge is not null %}
                                        <span class="badge text-bg-warning">{{ item.badge }}</span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </nav>
        <div class="settings-content">
            {% block settings_content %}{% endblock %}
        </div>
    </div>
{% endblock %}
