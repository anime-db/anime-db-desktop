{#
 # Optional host-side helper for the common "list of catalog-like records" widget shape (issue
 # #212). A widget plugin is never required to use it — render() only has to return a raw HTML
 # string — but reusing it keeps such widgets visually consistent with anime-list's own cards,
 # since it reuses the very same `.anime-card` classes from css/anime-list.css. Any template that
 # includes this partial (directly, or indirectly by rendering a widget response into the anime
 # detail page) must have that stylesheet loaded.
 #
 # Expects a single `items` variable: a list of
 #     {thumbnail: string|null, title: string, subtitle: string|null, url: string}
 # - thumbnail: absolute or app-media:// image URL; omitted (null/empty) falls back to a
 #   placeholder box, same as anime-list's own cards without a cover.
 # - title: record title, plain text.
 # - subtitle: short meta line under the title (e.g. type/year/score); omitted if null.
 # - url: link target for the whole card, typically the plugin's own external page for the record.
 #}
<ul class="plugin-widget__list">
    {% for item in items %}
        <li>
            <a class="anime-card" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
                {% if item.thumbnail %}
                    <img class="anime-card__thumb" src="{{ item.thumbnail }}" alt="{{ item.title }}" loading="lazy">
                {% else %}
                    <div class="anime-card__thumb anime-card__thumb--placeholder">{{ 'anime_detail.no_cover'|trans }}</div>
                {% endif %}
                <div class="anime-card__body">
                    <p class="anime-card__title"><bdi>{{ item.title }}</bdi></p>
                    {% if item.subtitle %}
                        <p class="anime-card__meta">{{ item.subtitle }}</p>
                    {% endif %}
                </div>
            </a>
        </li>
    {% endfor %}
</ul>
