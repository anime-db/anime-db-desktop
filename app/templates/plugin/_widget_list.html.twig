{#
 # Optional host-side helper for the common "list of catalog-like records" widget shape (issue
 # #212). A widget plugin is never required to use it — render() only has to return a raw HTML
 # string — but reusing it keeps such widgets visually consistent with anime-list's own cards,
 # since it reuses the very same `.anime-card` classes. Those live in the global bundle
 # (app/assets/scss/_anime-list.scss, compiled into css/app.css), which base.html.twig loads on
 # every page, so no per-page stylesheet is needed.
 #
 # Expects a single `items` variable: a list of \AnimeDb\PluginContracts\Widget\WidgetListItem
 # instances — see that class for the field-by-field definition of the shape. A plain array with
 # the same keys renders the same way, since Twig doesn't distinguish object-property access from
 # array-key access; that path is kept only for widgets whose plugin manifest omits the optional
 # `require.plugin-contracts` field and so has nothing to construct the DTO from. Such an array is
 # tolerated by the template, not a contract in its own right.
 #}
<ul class="plugin-widget__list">
    {% for item in items %}
        <li>
            <a class="anime-card" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
                {% if item.thumbnail %}
                    <img class="anime-card__thumb" src="{{ item.thumbnail }}" alt="" loading="lazy">
                {% else %}
                    <div class="anime-card__thumb anime-card__thumb--placeholder"></div>
                {% endif %}
                <div class="anime-card__body">
                    <p class="anime-card__title" title="{{ item.title }}"><bdi>{{ item.title }}</bdi></p>
                    {% if item.subtitle %}
                        <p class="anime-card__meta">{{ item.subtitle }}</p>
                    {% endif %}
                </div>
            </a>
        </li>
    {% endfor %}
</ul>
