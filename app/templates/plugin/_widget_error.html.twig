{#
 # Rendered by PluginWidgetController when the plugin's own render() throws: the failure is
 # isolated to this widget's slot, so the retry button re-issues the very same GET instead of
 # reloading the whole page. Expects: pluginId (string), retryUrl (string).
 #}
<div class="plugin-widget plugin-widget--error">
    <p class="plugin-widget__error-text">{{ 'plugin_widget.error'|trans({'%source%': bidi_isolate(pluginId)}) }}</p>
    <button type="button" class="plugin-widget__retry-button" hx-get="{{ retryUrl }}" hx-target="closest .plugin-widget" hx-swap="outerHTML">
        {{- 'plugin_widget.retry_button'|trans -}}
    </button>
</div>
