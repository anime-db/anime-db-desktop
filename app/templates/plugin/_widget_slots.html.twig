{#
 # Shared by anime/show.html.twig (entry widgets) and anime/list.html.twig (catalog widgets,
 # issue #720): one `hx-get` placeholder per active widget, loaded independently right after the
 # host page appears, so a slow or failing plugin never blocks the rest of the page.
 #
 # Expects: widgets (list<array{pluginId: string, widgetName: string}>), entryId (int, optional).
 # entryId is added to the plugin_widget route only when given — CatalogWidgetInterface::render()
 # takes no entry argument, so a catalog widget's slot must not carry one.
 #}
{% for widget in widgets %}
    {% set params = {pluginId: widget.pluginId, widgetName: widget.widgetName} %}
    {% if entryId is defined and entryId is not null %}
        {% set params = params|merge({entryId: entryId}) %}
    {% endif %}
    <section>
        <div
            class="plugin-widget"
            hx-get="{{ path('plugin_widget', params) }}"
            hx-trigger="load"
            hx-swap="innerHTML"
        >{{ 'plugin_widget.loading'|trans }}</div>
    </section>
{% endfor %}
