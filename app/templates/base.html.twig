<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ text_direction(app.request.locale) }}" data-theme-preference="{{ theme_preference() }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="htmx-config" content='{"includeIndicatorStyles":false}'>
    <title>{% block title %}AnimeDB{% endblock %}</title>
    {# Глобальный бандл: Bootstrap + токены палитры + стили шапки, уведомлений и htmx.
       Собирается из app/assets/scss шагом сборки, в git не хранится. RTL-вариант получается
       из того же исходника прогоном через RTLCSS — см. scripts/build-assets.js. #}
    <link rel="stylesheet" href="{{ asset(text_direction(app.request.locale) == 'rtl' ? 'css/app.rtl.css' : 'css/app.css') }}">
    {% block stylesheets %}{% endblock %}
    {# Единственный тег на весь клиентский код хоста (issue #735), синхронный и в head: внутри
       него color-mode должен отработать до первой отрисовки (иначе мигает светлый фон), а
       делегированный обработчик error — раньше, чем парсер дойдёт до самого первого
       <img class="anime-detail__cover"> в теле страницы (issue #633). Остальные модули на
       загрузке DOM не трогают (issue #734) — они лишь регистрируют контролы, которые
       controller.js монтирует по htmx:load, — но должны быть готовы раньше любого постраничного
       блока javascripts (ассеты плагинов), поэтому весь бандл целиком стоит здесь. Собирается
       из app/assets/js через esbuild шагом сборки, в git не хранится —
       см. scripts/build-assets.js. #}
    <script src="{{ asset('js/main.js') }}"></script>
</head>
<body>
    {# Header (issue #834): a word-mark link to the catalog on the left, "Add" (a dropdown menu)
     # and "Settings" buttons on the right. Hand-rolled, not Bootstrap's .navbar — that pulls in
     # breakpoint collapse-to-burger logic this desktop-only window never needs (see _nav.scss).
     #
     # `current_nav_section` still distinguishes "catalog" from "settings" routes, the same
     # computation the earlier two-link bar used (issue #822/#825): "Settings" stays highlighted
     # for every settings_*/storage_* route, except the ones that are a step of adding entries to
     # the catalog rather than a settings screen — storage_scan_prompt and, since issue #834,
     # storage_scan_progress (both extend base.html.twig directly, with no sidebar). The word-mark
     # itself is never highlighted — there is no visual "catalog" state anymore — but the section
     # is still computed so a catalog-ish route is reliably excluded from "settings".
     #}
    {% set current_route = app.request.attributes.get('_route')|default('') %}
    {% if current_route in ['storage_scan_prompt', 'storage_scan_progress'] or current_route starts with 'anime_' or current_route == 'home_index' %}
        {% set current_nav_section = 'catalog' %}
    {% elseif current_route starts with 'settings_' or current_route starts with 'storage_' %}
        {% set current_nav_section = 'settings' %}
    {% elseif current_route starts with 'downloads_' %}
        {% set current_nav_section = 'downloads' %}
    {% else %}
        {% set current_nav_section = '' %}
    {% endif %}
    {% set searchPluginsState = top_nav_search_plugins_state() %}
    <nav class="app-nav" aria-label="{{ 'nav.aria_label'|trans }}">
        <a class="app-nav__brand" href="{{ path('home_index') }}">{{ 'nav.brand'|trans }}</a>

        <div class="app-nav__actions">
            <div class="dropdown app-nav__add" data-control="nav-add-menu" data-scan-section-url="{{ path('nav_add_menu_scan_section') }}">
                <button type="button" class="btn btn-primary dropdown-toggle d-inline-flex align-items-center gap-1" data-bs-toggle="dropdown" aria-expanded="false">
                    {{ icon('plus-lg') }}
                    {{ 'nav.add_button'|trans }}
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        {% if searchPluginsState.active %}
                            <a class="dropdown-item" href="{{ path('anime_search_plugins') }}">{{ 'nav.add_menu_search_plugins'|trans }}</a>
                        {% else %}
                            <span class="dropdown-item disabled" aria-disabled="true">{{ 'nav.add_menu_search_plugins'|trans }}</span>
                        {% endif %}
                    </li>
                    {% if not searchPluginsState.active and searchPluginsState.hint is not null %}
                        <li><span class="dropdown-item-text small text-body-secondary">{{ ('nav.add_menu_search_plugins_hint_' ~ searchPluginsState.hint.kind)|trans }}</span></li>
                        <li><a class="dropdown-item small" href="{{ searchPluginsState.hint.kind == 'not_installed' ? path('settings_market_index', {feature: 'filler'}) : searchPluginsState.hint.url }}">{{ ('nav.add_menu_search_plugins_hint_link_' ~ searchPluginsState.hint.kind)|trans }}</a></li>
                    {% endif %}
                    <li><hr class="dropdown-divider"></li>
                    <li class="dropdown-header">{{ 'nav.add_menu_scan_heading'|trans }}</li>
                    <li class="app-nav__scan-section" data-nav-scan-section>
                        <div class="dropdown-item-text app-nav__scan-loading" data-nav-scan-loading>
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            {{ 'nav.add_menu_scan_loading'|trans }}
                        </div>
                        <div class="dropdown-item-text" data-nav-scan-error hidden>{{ 'nav.add_menu_scan_error'|trans }}</div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="{{ path('storage_new') }}">{{ 'nav.add_menu_add_storage'|trans }}</a></li>
                    <li><a class="dropdown-item" href="{{ path('anime_new') }}">{{ 'nav.add_menu_empty_entry'|trans }}</a></li>
                </ul>
            </div>

            <a class="app-nav__link{% if current_nav_section == 'downloads' %} app-nav__link--active{% endif %} btn btn-outline-secondary d-inline-flex align-items-center gap-1" href="{{ path('downloads_index') }}"{% if current_nav_section == 'downloads' %} aria-current="page"{% endif %}>
                {{ icon('download') }}
                {{ 'nav.downloads_link'|trans }}
            </a>

            <a class="app-nav__link{% if current_nav_section == 'settings' %} app-nav__link--active{% endif %} btn btn-outline-secondary d-inline-flex align-items-center gap-1" href="{{ path('settings_index') }}"{% if current_nav_section == 'settings' %} aria-current="page"{% endif %}>
                {{ icon('gear') }}
                {{ 'nav.settings_link'|trans }}
            </a>
        </div>
    </nav>
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} mx-3 mt-3 mb-0" role="alert">
                {{ message.text }}
                {%- if message.link_url is not null %} <a href="{{ message.link_url }}" class="alert-link">{{ message.link_label }}</a>{% endif %}
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
    <div id="app-notifications" class="app-notifications" data-control="app-notifications" data-request-error="{{ 'app_notification.request_failed'|trans }}" aria-live="polite"></div>
    <template id="icon-x-lg">{{ icon('x-lg') }}</template>
    <template id="app-notification-template">
        <div class="app-notification" role="alert">
            <div class="app-notification__text">
                <strong class="app-notification__title"></strong>
                <p class="app-notification__message"></p>
            </div>
            <button type="button" class="app-notification__close" aria-label="{{ 'app_notification.close_button'|trans }}">{{ icon('x-lg') }}</button>
        </div>
    </template>
    <script src="{{ asset('js/htmx.min.js') }}"></script>
    {# Компоненты Bootstrap с data-атрибутами (dropdown, modal, collapse, tab) вешают
       делегированные обработчики на document, поэтому на разметке, вставленной htmx-свопом,
       работают без реинициализации. Tooltip и Popover — исключение, они создаются только явно:
       если появятся, инициализировать их придётся по событию htmx:afterSwap. #}
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
