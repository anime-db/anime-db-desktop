{% extends 'base.html.twig' %}

{% block title %}{{ 'downloads.title'|trans }}{% endblock %}

{% block body %}
    {# data-status-url feeds downloads-list.js's polling loop (issue #854); the rows/orphans
     # markup below is rebuilt wholesale by that same control on every successful poll, so its
     # row-building logic must stay in lockstep with the <tr> shape here — see downloads-list.js. #}
    <main class="downloads-list py-4" data-control="downloads-list" data-status-url="{{ path('downloads_status') }}" data-no-card-label="{{ 'downloads.no_card_badge'|trans }}" data-stale-hint-label="{{ 'downloads.action_stale_hint'|trans }}">
        <h1>{{ 'downloads.heading'|trans }}</h1>

        <div class="alert alert-warning" data-downloads-banner{% if qbittorrentAvailable %} hidden{% endif %}>
            {{ 'downloads.qbittorrent_unavailable'|trans }}
        </div>

        {% if actionError is defined and actionError %}
            <div class="alert alert-danger">{{ actionError|trans }}</div>
        {% endif %}

        {% set hasAnyRow = rows is not empty or orphans is not empty %}

        {# Both the table and the empty-state message are always rendered — downloads-list.js
         # toggles their visibility on every poll response instead of relying on the SSR state,
         # otherwise a page that first rendered empty would have no <tbody> to append rows to. #}
        <p class="text-body-secondary" data-downloads-empty{% if hasAnyRow %} hidden{% endif %}>{{ 'downloads.empty'|trans }}</p>
        <div class="table-responsive" data-downloads-table-wrapper{% if not hasAnyRow %} hidden{% endif %}>
            <table class="table align-middle" data-downloads-table>
                <thead>
                    <tr>
                        <th>{{ 'downloads.column_name'|trans }}</th>
                        <th>{{ 'downloads.column_status'|trans }}</th>
                        <th>{{ 'downloads.column_size'|trans }}</th>
                        <th>{{ 'downloads.column_progress'|trans }}</th>
                        <th>{{ 'downloads.column_download_speed'|trans }}</th>
                        <th>{{ 'downloads.column_upload_speed'|trans }}</th>
                        <th>{{ 'downloads.column_eta'|trans }}</th>
                        <th>{{ 'downloads.column_peers'|trans }}</th>
                        <th>{{ 'downloads.column_storage'|trans }}</th>
                        <th>{{ 'downloads.column_actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody data-downloads-rows>
                    {% for row in rows|merge(orphans) %}
                        <tr data-info-hash="{{ row.infoHash }}"{% if not row.hasCard %} class="table-warning"{% endif %}>
                            <td>
                                {% if row.animeUrl is not null %}<a href="{{ row.animeUrl }}">{% endif %}
                                    <bdi>{{ row.displayName }}</bdi>
                                {% if row.animeUrl is not null %}</a>{% endif %}
                                {% if not row.hasCard %}
                                    <span class="badge text-bg-secondary ms-1">{{ 'downloads.no_card_badge'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ row.statusText }}</td>
                            <td>{{ row.sizeText }}</td>
                            <td>{{ row.progressText }}</td>
                            <td>{{ row.downloadSpeedText }}</td>
                            <td>{{ row.uploadSpeedText }}</td>
                            <td>{{ row.etaText }}</td>
                            <td>{{ row.peersText }}</td>
                            <td>{{ row.targetStorageName }}</td>
                            <td data-field="actions"{% if row.hasCard %} data-version="{{ row.version }}" data-status="{{ row.coreStatus }}"{% endif %}>
                                {% if row.hasCard %}
                                    {% if row.canPause %}
                                        <form method="post" action="{{ path('download_pause', {id: row.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('download_pause_' ~ row.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'downloads.action_pause'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if row.canResume %}
                                        <form method="post" action="{{ path('download_resume', {id: row.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('download_resume_' ~ row.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'downloads.action_resume'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if row.canRetry %}
                                        <form method="post" action="{{ path('download_retry', {id: row.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('download_retry_' ~ row.id) }}">
                                            <input type="hidden" name="version" value="{{ row.version }}">
                                            <input type="hidden" name="status" value="{{ row.coreStatus }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'downloads.action_retry'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if row.canStopSeeding %}
                                        <form method="post" action="{{ path('download_stop_seeding', {id: row.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('download_stop_seeding_' ~ row.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'downloads.action_stop_seeding'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    {% if row.canDelete %}
                                        <form method="post" action="{{ path('download_delete', {id: row.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('download_delete_' ~ row.id) }}">
                                            <input type="hidden" name="version" value="{{ row.version }}">
                                            <input type="hidden" name="status" value="{{ row.coreStatus }}">
                                            {% if row.hasTorrentInClient %}
                                                <label class="me-1">
                                                    <input type="checkbox" name="delete_files" value="1"{% if row.deleteFilesDefaultChecked %} checked{% endif %}>
                                                    {{ 'downloads.action_delete_files_label'|trans }}
                                                </label>
                                            {% endif %}
                                            <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'downloads.action_delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                {% else %}
                                    <form method="post" action="{{ path('download_delete_orphan', {infoHash: row.infoHash}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('download_delete_orphan_' ~ row.infoHash) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'downloads.action_delete_from_client'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}
