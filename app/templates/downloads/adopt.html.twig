{% extends 'base.html.twig' %}

{% block title %}{{ 'download_adopt.title'|trans }}{% endblock %}

{% block body %}
    <main class="download-new py-4" data-control="download-new">
        <h1>{{ 'download_adopt.heading'|trans }}</h1>

        {% if torrentName is not null %}
            <p><bdi>{{ torrentName }}</bdi></p>
        {% endif %}

        {% if error %}
            <p class="alert alert-danger">{{ error|trans(errorParams) }}</p>
        {% endif %}

        <p class="form-text">{{ 'download_adopt.storage_hint'|trans }}</p>

        <form method="post" action="{{ path('download_adopt_orphan', {infoHash: infoHash}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('download_adopt_orphan_' ~ infoHash) }}">
            <input type="hidden" name="anime" id="download-new-anime-id" value="{{ selectedAnime ? selectedAnime.id : '' }}">

            <div class="mb-3">
                <label for="download-new-anime-search" class="form-label">{{ 'download_new.field_anime_label'|trans }}</label>
                <input type="text" id="download-new-anime-search" class="form-control" autocomplete="off"
                       value="{{ selectedAnime ? selectedAnime.title : '' }}"
                       placeholder="{{ 'download_new.field_anime_placeholder'|trans }}" required>
                <ul class="list-group" id="download-new-anime-results" hidden></ul>
            </div>

            <button type="submit" class="btn btn-primary"{% if torrentName is null %} disabled{% endif %}>{{ 'download_adopt.submit_button'|trans }}</button>
        </form>
    </main>
{% endblock %}
