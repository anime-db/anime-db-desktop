{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'storage_scan_log.title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="storage-scan-log py-4">
        <h1>{{ 'storage_scan_log.heading'|trans({'%name%': bidi_isolate(storage.name)}) }}</h1>

        {% if runs is empty %}
            <p class="text-body-secondary">{{ 'storage_scan_log.empty'|trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'storage_scan_log.started_column'|trans }}</th>
                            <th>{{ 'storage_scan_log.status_column'|trans }}</th>
                            <th>{{ 'storage_scan_log.counts_column'|trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in runs %}
                            <tr>
                                <td>{{ run.startedAt|date('Y-m-d H:i') }}</td>
                                <td>{{ ('storage_scan_log.status_' ~ run.status.value)|trans }}</td>
                                <td>
                                    {% for type, labelKey in groupLabelKeys %}
                                        {% if (run.counts[type] ?? 0) > 0 %}
                                            <div>{{ 'storage_scan_log.count_text'|trans({'%label%': labelKey|trans, '%count%': run.counts[type]}) }}</div>
                                        {% endif %}
                                    {% endfor %}
                                </td>
                                <td><a href="{{ path('storage_scan_run', {id: storage.id, run: run.id}) }}">{{ 'storage_scan_log.open_link'|trans }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {{ include('_back_link.html.twig', {url: path('storage_index'), label: 'storage_scan_log.storages_link'|trans, inline: true}) }}
    </main>
{% endblock %}
