{#
 # Results of one scan journal run (issue #998): the status line and the #storage-scan section that
 # storage-scan.js fills from the run's items endpoint — the same renderer as a live scan. Expects
 # `storage` and `run` (App\Service\Storage\Scan\ScanRun).
 #}
<p class="mb-2">
    <span class="badge text-bg-secondary">{{ ('storage_scan_log.status_' ~ run.status.value)|trans }}</span>
    <span class="text-body-secondary ms-1">{{ run.startedAt|date('Y-m-d H:i') }}</span>
</p>

{% if run.errorMessage is not null and run.status.value in ['failed', 'marker_conflict'] %}
    <p class="alert alert-danger" role="alert">{{ 'storage_scan_log.run_error'|trans({'%message%': run.errorMessage}) }}</p>
{% endif %}

{% if run.status.value == 'done' %}
    <section class="storage-scan mb-4"
             id="storage-scan"
             data-control="storage-scan"
             data-storage-id="{{ storage.id }}"
             data-items-url="{{ path('storage_scan_run_items', {id: storage.id, run: run.id}) }}"
             data-confirm-url="{{ path('storage_scan_confirm', {id: storage.id}) }}"
             data-confirm-token="{{ csrf_token('storage_scan_confirm_' ~ storage.id) }}"
             data-anime-new-url="{{ path('anime_new') }}">
        <p id="storage-scan-error" role="alert" hidden></p>

        <div id="storage-scan-results" hidden></div>
    </section>
{% elseif run.status.value == 'interrupted' %}
    <p class="text-body-secondary">{{ 'storage_scan_log.interrupted_hint'|trans }}</p>
{% endif %}
