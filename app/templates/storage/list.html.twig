{% extends 'base.html.twig' %}

{% block title %}{{ 'storage_list.title'|trans }}{% endblock %}

{% block body %}
    <main class="storage-list container py-4">
        <h1>{{ 'storage_list.heading'|trans }}</h1>

        <p class="mb-4"><a href="{{ path('storage_new') }}" class="btn btn-primary">{{ 'storage_list.new_button'|trans }}</a></p>

        {% if scanned %}
            <p class="alert alert-info">{{ 'storage_list.scan_started'|trans }}</p>
        {% endif %}

        {% if scannedStorageId is not null %}
            <section class="storage-scan mb-4"
                     id="storage-scan"
                     data-storage-id="{{ scannedStorageId }}"
                     data-confirm-url="{{ path('storage_scan_confirm', {id: scannedStorageId}) }}"
                     data-confirm-token="{{ csrf_token('storage_scan_confirm_' ~ scannedStorageId) }}"
                     data-anime-new-url="{{ path('anime_new') }}">
                <h2>{{ 'storage_list.scan_heading'|trans }}</h2>

                <div id="storage-scan-progress">
                    <div class="progress">
                        <div class="progress-bar" id="storage-scan-progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span id="storage-scan-progress-text"></span>
                </div>

                <p id="storage-scan-error" hidden></p>

                <div id="storage-scan-results" hidden></div>
            </section>
        {% endif %}

        {% if storages is empty %}
            <p class="text-body-secondary">{{ 'storage_list.empty'|trans }}</p>
        {% else %}
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ 'storage_list.name_column'|trans }}</th>
                        <th>{{ 'storage_list.type_column'|trans }}</th>
                        <th>{{ 'storage_list.path_column'|trans }}</th>
                        <th>{{ 'storage_list.last_scan_column'|trans }}</th>
                        <th>{{ 'storage_list.actions_column'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for storage in storages %}
                        <tr>
                            <td><bdi>{{ storage.name }}</bdi></td>
                            <td>{{ ('storage_type.' ~ storage.type.value)|trans }}</td>
                            <td>
                                <bdi>{{ storage.path }}</bdi>
                                {% if storage.id in unavailableStorageIds %}
                                    <span class="badge text-bg-warning ms-1">{{ 'storage_list.path_unavailable'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ storage.dateUpdate ? storage.dateUpdate|date('Y-m-d H:i') : ('storage_list.never_scanned'|trans) }}</td>
                            <td>
                                <a href="{{ path('storage_edit', {id: storage.id}) }}" class="btn btn-outline-secondary btn-sm me-2">{{ 'storage_list.edit_button'|trans }}</a>
                                <form method="post" action="{{ path('storage_scan', {id: storage.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('storage_scan_' ~ storage.id) }}">
                                    <button type="submit" class="btn btn-outline-primary btn-sm me-2">{{ 'storage_list.scan_button'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('storage_delete', {id: storage.id}) }}" data-confirm="{{ 'storage_list.delete_confirm'|trans({'%name%': bidi_isolate(storage.name)}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('storage_delete_' ~ storage.id) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'storage_list.delete_button'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/scan.js') }}"></script>
    <script src="{{ asset('js/storage-scan.js') }}"></script>
{% endblock %}
