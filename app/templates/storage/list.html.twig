{% extends 'base.html.twig' %}

{% block title %}{{ 'storage_list.title'|trans }}{% endblock %}

{% block body %}
    <main class="storage-list">
        <h1>{{ 'storage_list.heading'|trans }}</h1>

        <p><a href="{{ path('storage_new') }}">{{ 'storage_list.new_button'|trans }}</a></p>

        {% if scanned %}
            <p class="storage-list__notice">{{ 'storage_list.scan_started'|trans }}</p>
        {% endif %}

        {% if scannedStorageId is not null %}
            <section class="storage-scan"
                     id="storage-scan"
                     data-storage-id="{{ scannedStorageId }}"
                     data-confirm-url="{{ path('storage_scan_confirm', {id: scannedStorageId}) }}"
                     data-confirm-token="{{ csrf_token('storage_scan_confirm_' ~ scannedStorageId) }}"
                     data-anime-new-url="{{ path('anime_new') }}">
                <h2>{{ 'storage_list.scan_heading'|trans }}</h2>

                <div class="storage-scan__progress" id="storage-scan-progress">
                    <progress id="storage-scan-progress-bar" max="100" value="0"></progress>
                    <span id="storage-scan-progress-text"></span>
                </div>

                <p class="storage-scan__error" id="storage-scan-error" hidden></p>

                <div class="storage-scan__results" id="storage-scan-results" hidden></div>
            </section>
        {% endif %}

        {% if storages is empty %}
            <p>{{ 'storage_list.empty'|trans }}</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>{{ 'storage_list.name_column'|trans }}</th>
                        <th>{{ 'storage_list.type_column'|trans }}</th>
                        <th>{{ 'storage_list.path_column'|trans }}</th>
                        <th>{{ 'storage_list.last_scan_column'|trans }}</th>
                        <th>{{ 'storage_list.actions_column'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for storage in storages %}
                        <tr>
                            <td>{{ storage.name }}</td>
                            <td>{{ ('storage_type.' ~ storage.type.value)|trans }}</td>
                            <td>{{ storage.path }}</td>
                            <td>{{ storage.dateUpdate ? storage.dateUpdate|date('Y-m-d H:i') : ('storage_list.never_scanned'|trans) }}</td>
                            <td>
                                <a href="{{ path('storage_edit', {id: storage.id}) }}">{{ 'storage_list.edit_button'|trans }}</a>
                                <form method="post" action="{{ path('storage_scan', {id: storage.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('storage_scan_' ~ storage.id) }}">
                                    <button type="submit">{{ 'storage_list.scan_button'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/scan.js') }}"></script>
    <script src="{{ asset('js/storage-scan.js') }}"></script>
{% endblock %}
