{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'storage_list.title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="storage-list py-4">
        <h1>{{ 'storage_list.heading'|trans }}</h1>

        <p class="mb-4">
            <a href="{{ path('storage_new') }}" class="btn btn-primary d-inline-flex align-items-center gap-2">
                {{ icon('plus-lg') }}
                {{ 'storage_list.new_button'|trans }}
            </a>
        </p>

        {% if storages is empty %}
            <p class="text-body-secondary">{{ 'storage_list.empty'|trans }}</p>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'storage_list.name_column'|trans }}</th>
                            <th>{{ 'storage_list.type_column'|trans }}</th>
                            <th>{{ 'storage_list.path_column'|trans }}</th>
                            <th>{{ 'storage_list.last_scan_column'|trans }}</th>
                            <th>{{ 'storage_list.actions_column'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for storage in storages %}
                            <tr>
                                <td><bdi>{{ storage.name }}</bdi></td>
                                <td>{{ ('storage_type.' ~ storage.type.value)|trans }}</td>
                                <td class="storage-list__path">
                                    <bdi>{{ storage.path }}</bdi>
                                    {% if storage.id in unavailableStorageIds %}
                                        <span class="badge text-bg-warning ms-1">{{ 'storage_list.path_unavailable'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ storage.dateUpdate ? storage.dateUpdate|date('Y-m-d H:i') : ('storage_list.never_scanned'|trans) }}</td>
                                <td>
                                    <div class="d-flex gap-2 align-items-center flex-nowrap">
                                        <a href="{{ path('storage_edit', {id: storage.id}) }}" class="btn btn-outline-secondary btn-sm btn-icon" title="{{ 'storage_list.edit_button'|trans }}" aria-label="{{ 'storage_list.edit_button'|trans }}">
                                            {{ icon('pencil') }}
                                        </a>
                                        <form method="post" action="{{ path('storage_scan', {id: storage.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('storage_scan_' ~ storage.id) }}">
                                            <button type="submit" class="btn btn-outline-primary btn-sm btn-icon" title="{{ 'storage_list.scan_button'|trans }}" aria-label="{{ 'storage_list.scan_button'|trans }}">
                                                {{ icon('arrow-repeat') }}
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('storage_delete', {id: storage.id}) }}" data-confirm="{{ 'storage_list.delete_confirm'|trans({'%name%': bidi_isolate(storage.name)}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('storage_delete_' ~ storage.id) }}">
                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-icon" title="{{ 'storage_list.delete_button'|trans }}" aria-label="{{ 'storage_list.delete_button'|trans }}">
                                                {{ icon('trash') }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </main>
{% endblock %}
