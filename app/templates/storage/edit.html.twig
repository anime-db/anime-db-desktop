{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'storage_edit.title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="py-4">
        <h1>{{ 'storage_edit.heading'|trans }}</h1>

        {% if error %}
            <p class="alert alert-danger">{{ error|trans(errorParams|default({})) }}</p>
        {% endif %}

        <form method="post" action="{{ path('storage_update', {id: storage.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('storage_edit_' ~ storage.id) }}">

            <div class="mb-3">
                <label for="storage-edit-name" class="form-label">{{ 'storage_edit.field_name'|trans }}</label>
                <input type="text" id="storage-edit-name" name="name" value="{{ name }}" required class="form-control">
            </div>

            <div class="mb-3">
                <label for="storage-edit-type" class="form-label">{{ 'storage_edit.field_type'|trans }}</label>
                <select id="storage-edit-type" name="type" class="form-select">
                    {% for value in types %}
                        <option value="{{ value }}"{% if value == type %} selected{% endif %}>{{ ('storage_type.' ~ value)|trans }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label for="storage-edit-path" class="form-label">{{ 'storage_edit.field_path'|trans }}</label>
                <input type="text" id="storage-edit-path" name="path" value="{{ path }}" required class="form-control"{% if isPreset %} readonly{% endif %}>
                {% if isPreset %}
                    <div class="form-text">{{ 'storage_edit.preset_path_hint'|trans }}</div>
                {% endif %}
            </div>

            <button type="submit" class="btn btn-primary">{{ 'storage_edit.submit_button'|trans }}</button>
        </form>
    </main>
{% endblock %}
