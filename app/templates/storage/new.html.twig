{% extends 'base.html.twig' %}

{% block title %}{{ 'storage_new.title'|trans }}{% endblock %}

{% block body %}
    <main class="storage-new">
        <h1>{{ 'storage_new.heading'|trans }}</h1>

        {% if error %}
            <p class="storage-new__error">{{ error|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('storage_create') }}" class="storage-new__form">
            <input type="hidden" name="_token" value="{{ csrf_token('storage_new') }}">

            <label for="storage-new-name">{{ 'storage_new.field_name'|trans }}</label>
            <input type="text" id="storage-new-name" name="name" value="{{ name }}" required>

            <label for="storage-new-type">{{ 'storage_new.field_type'|trans }}</label>
            <select id="storage-new-type" name="type" data-writable-types="{{ writable_types|join(',') }}">
                {% for value in types %}
                    <option value="{{ value }}"{% if value == type %} selected{% endif %}>{{ ('storage_type.' ~ value)|trans }}</option>
                {% endfor %}
            </select>

            <label for="storage-new-path">{{ 'storage_new.field_path'|trans }}</label>
            <div class="storage-new__path-row">
                <input type="text" id="storage-new-path" name="path" value="{{ path }}" required>
                <button type="button" id="storage-new-pick-folder" hidden>{{ 'storage_new.pick_folder_button'|trans }}</button>
            </div>

            <button type="submit">{{ 'storage_new.submit_button'|trans }}</button>
        </form>

        <p><a href="{{ path('home_index') }}">{{ 'storage_new.skip_link'|trans }}</a></p>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/storage-new.js') }}"></script>
{% endblock %}
