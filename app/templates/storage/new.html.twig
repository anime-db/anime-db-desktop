{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'storage_new.title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="py-4">
        <h1>{{ 'storage_new.heading'|trans }}</h1>

        {% if error %}
            <p class="alert alert-danger">{{ error|trans }}</p>
        {% endif %}

        <form method="post" action="{{ path('storage_create') }}" data-control="storage-new">
            <input type="hidden" name="_token" value="{{ csrf_token('storage_new') }}">

            <div class="mb-3">
                <label for="storage-new-name" class="form-label">{{ 'storage_new.field_name'|trans }}</label>
                <input type="text" id="storage-new-name" name="name" value="{{ name }}" required class="form-control">
            </div>

            <div class="mb-3">
                <label for="storage-new-type" class="form-label">{{ 'storage_new.field_type'|trans }}</label>
                <select id="storage-new-type" name="type" data-writable-types="{{ writable_types|join(',') }}" data-path-optional-types="{{ path_optional_types|join(',') }}" data-path-not-applicable-types="{{ path_not_applicable_types|join(',') }}" class="form-select">
                    {% for value in types %}
                        <option value="{{ value }}"{% if value == type %} selected{% endif %}>{{ ('storage_type.' ~ value)|trans }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label for="storage-new-path" class="form-label">{{ 'storage_new.field_path'|trans }}</label>
                <div class="d-flex gap-2">
                    <input type="text" id="storage-new-path" name="path" value="{{ type in path_not_applicable_types ? '' : path }}"{% if type in path_not_applicable_types %} disabled{% elseif type not in path_optional_types %} required{% endif %} class="form-control">
                    <button type="button" id="storage-new-pick-folder" class="btn btn-outline-secondary text-nowrap" hidden>{{ 'storage_new.pick_folder_button'|trans }}</button>
                </div>
                <div id="storage-new-path-not-applicable" class="form-text"{% if type not in path_not_applicable_types %} hidden{% endif %}>{{ 'storage_new.path_not_applicable_hint'|trans }}</div>
            </div>

            <button type="submit" class="btn btn-primary">{{ 'storage_new.submit_button'|trans }}</button>
        </form>

        <p class="mt-3"><a href="{{ path('home_index') }}">{{ 'storage_new.skip_link'|trans }}</a></p>
    </main>
{% endblock %}
