{#
 # Scan progress/candidate-confirmation page (issue #834), extending base.html.twig directly —
 # like storage/scan_prompt.html.twig, not settings/_layout.html.twig — because this is a step of
 # adding entries to the catalog, not a settings screen. See base.html.twig for the top-nav
 # highlighting rule this route is excluded from.
 #
 # The `started` flag (set by StorageController::scan()'s redirect) is what tells a request that
 # just triggered a scan apart from a bare/refreshed GET: only the former mounts storage-scan.js
 # and its progress UI, moved here unchanged from storage/list.html.twig.
 #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'storage_scan_progress.title'|trans }}{% endblock %}

{% block body %}
    <main class="container py-4">
        <h1>{{ 'storage_scan_progress.heading'|trans }}</h1>

        {% if started %}
            <section class="storage-scan mb-4"
                     id="storage-scan"
                     data-control="storage-scan"
                     data-storage-id="{{ storage.id }}"
                     data-confirm-url="{{ path('storage_scan_confirm', {id: storage.id}) }}"
                     data-confirm-token="{{ csrf_token('storage_scan_confirm_' ~ storage.id) }}"
                     data-anime-new-url="{{ path('anime_new') }}">
                <div id="storage-scan-progress" aria-live="polite">
                    <div class="progress">
                        <div class="progress-bar" id="storage-scan-progress-bar" role="progressbar" aria-label="{{ 'storage_scan_progress.progress_label'|trans }}" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <span id="storage-scan-progress-text"></span>
                </div>

                <p id="storage-scan-error" role="alert" hidden></p>

                <div id="storage-scan-results" hidden></div>
            </section>
        {% else %}
            {% if failedRun %}
                <p class="alert alert-warning">
                    <span class="badge text-bg-secondary">{{ ('storage_scan_log.status_' ~ failedRun.status.value)|trans }}</span>
                    <span class="ms-1">{{ failedRun.startedAt|date('Y-m-d H:i') }}</span>
                    {% if failedRun.errorMessage is not null and failedRun.status.value in ['failed', 'marker_conflict'] %}
                        {{ 'storage_scan_log.run_error'|trans({'%message%': failedRun.errorMessage}) }}
                    {% endif %}
                </p>
            {% endif %}
            {% if latestRun %}
                <h2 class="h5">{{ 'storage_scan_progress.last_run_heading'|trans }}</h2>

                {% include 'storage/_scan_run_results.html.twig' with {run: latestRun} %}

                <p><a href="{{ path('storage_scans', {id: storage.id}) }}">{{ 'storage_list.scan_log_link'|trans }}</a></p>
            {% else %}
                <p class="text-body-secondary">{{ 'storage_scan_progress.not_started'|trans }}</p>
            {% endif %}

            <form method="post" action="{{ path('storage_scan', {id: storage.id}) }}" class="mb-3">
                <input type="hidden" name="_token" value="{{ csrf_token('storage_scan_' ~ storage.id) }}">
                <button type="submit" class="btn btn-primary">{{ 'storage_scan_progress.scan_button'|trans }}</button>
            </form>
        {% endif %}

        {{ include('_back_link.html.twig', {url: path('home_index'), label: 'storage_scan_progress.catalog_link'|trans, inline: true}) }}
    </main>
{% endblock %}
