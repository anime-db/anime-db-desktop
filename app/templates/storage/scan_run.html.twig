{% extends 'settings/_layout.html.twig' %}

{% block title %}{{ 'storage_scan_log.run_title'|trans }}{% endblock %}

{% block settings_content %}
    <main class="storage-scan-run py-4">
        <h1>{{ 'storage_scan_log.run_heading'|trans({'%name%': bidi_isolate(storage.name)}) }}</h1>

        {% include 'storage/_scan_run_results.html.twig' %}

        {{ include('_back_link.html.twig', {url: path('storage_scans', {id: storage.id}), label: 'storage_scan_log.back_link'|trans, inline: true}) }}
    </main>
{% endblock %}
