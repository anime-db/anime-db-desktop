# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=321966fa772fcd1a73055cb36e5ccaa0
# ^ dev only; в production перекрывается через buildEnv() в native/supervisor/frankenphp.js
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> anime-db-desktop ###
# В продакшн все переменные переопределяются через env Electron (Таск 6).
DATABASE_URL=sqlite:///%kernel.project_dir%/../data/data.db
# Отдельный SQLite-файл для очереди Messenger — изолирован от пользовательских данных.
QUEUE_DATABASE_URL=sqlite:///%kernel.project_dir%/../data/queue.db
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=dev-key
# qbittorrent-nox's WebUI port is pinned, not discovered (see native/supervisor/qbittorrent.js).
QBITTORRENT_URL=http://127.0.0.1:18080
# Bundled ffprobe (native/paths.js); dev default points at the checkout's bin/ffprobe.
FFPROBE_BIN=%kernel.project_dir%/../bin/ffprobe/ffprobe.exe
###< anime-db-desktop ###

###> symfony/messenger ###
# Таблица messenger_messages создаётся вручную через `bin/console messenger:setup-transports`,
# не при первом подключении — см. issue #97.
MESSENGER_TRANSPORT_DSN=doctrine://queue?auto_setup=0
###< symfony/messenger ###
