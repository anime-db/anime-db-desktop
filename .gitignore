# Node.js
node_modules/

# Binaries — тянутся через scripts/download-bins.js, не хранятся в git
bin/frankenphp/
bin/meilisearch/
bin/qbittorrent-nox/
bin/ffprobe/
# Лицензионные файлы апстримов — извлекаются оттуда же (см. FRANKENPHP_LICENSE_FILES)
bin/licenses/

# Symfony
app/vendor/
app/var/
app/.env.local
app/.env.*.local

# Dev-режим SQLite (data.db, queue.db) — в продакшн живёт в AppData, не в репозитории
data/

# Frontend assets — генерируются при сборке (scripts/build-assets.js), не хранятся в git
app/public/js/htmx.min.js
app/public/js/bootstrap.bundle.min.js
app/public/css/app.css
app/public/css/app.rtl.css

# Отпечаток сборки — стемпуется на каждой сборке в scripts/build.js#writeBuildId, не хранится в git
scripts/build-id.txt

# Electron build output
dist/
out/

# UI screenshots — output of `npm run shots` (scripts/shots/run.js), not checked in
/shots/

# OS
.DS_Store
Thumbs.db
