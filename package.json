{
    "name": "anime-db-desktop",
    "version": "0.0.1",
    "description": "AnimeDB Desktop Application v2",
    "author": "Peter Gribanov <info@peter-gribanov.ru>",
    "license": "GPL-3.0-or-later",
    "main": "native/index.js",
    "scripts": {
        "start": "npm run assets && electron .",
        "assets": "node scripts/build-assets.js",
        "prebuild": "node scripts/build.js",
        "build": "electron-builder --publish never",
        "download-bins": "node scripts/download-bins.js",
        "download-e2e-runtime": "node scripts/download-e2e-runtime.js",
        "generate-php-ini": "node scripts/generate-php-ini.js",
        "check-runtime-parity": "node scripts/check-runtime-parity.js",
        "release-smoke": "node scripts/release-smoke.js",
        "shots": "node scripts/shots/run.js",
        "e2e": "node scripts/e2e/run.js",
        "e2e:session": "node scripts/e2e/session.js",
        "lint": "eslint native/ tests/native/ app/assets/js/ tests/public/ scripts/",
        "lint:fix": "eslint native/ tests/native/ app/assets/js/ tests/public/ scripts/ --fix",
        "test": "jest"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "bootstrap": "^5.3.8",
        "electron": "^35.0.0",
        "electron-builder": "^25.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.4",
        "globals": "^17.7.0",
        "htmx.org": "^2.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "rtlcss": "^4.3.0",
        "sass": "^1.104.0"
    },
    "build": {
        "appId": "org.anime-db.desktop",
        "productName": "AnimeDB",
        "copyright": "Copyright (c) 2026 Peter Gribanov",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "runAfterFinish": true,
            "include": "build/installer.nsh"
        },
        "files": [
            "native/**",
            "app/**",
            "bin/**",
            "resources/**",
            "scripts/versions.json",
            "scripts/build-id.txt",
            "!app/assets/**",
            "!app/var/**",
            "!node_modules/**",
            "!resources/third-party-licenses/**"
        ],
        "extraFiles": [
            {
                "from": "LICENSE",
                "to": "LICENSE.txt"
            },
            {
                "from": "resources/third-party-licenses",
                "to": "THIRD-PARTY-LICENSES"
            }
        ],
        "asar": false
    }
}
