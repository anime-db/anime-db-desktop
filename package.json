{
    "name": "anime-db-desktop",
    "version": "0.0.1",
    "description": "AnimeDB Desktop Application v2",
    "author": "Peter Gribanov <info@peter-gribanov.ru>",
    "license": "GPL-3.0-or-later",
    "main": "native/index.js",
    "scripts": {
        "start": "electron .",
        "prebuild": "node scripts/build.js",
        "build": "electron-builder",
        "download-bins": "node scripts/download-bins.js",
        "lint": "eslint native/",
        "lint:fix": "eslint native/ --fix",
        "test": "jest"
    },
    "devDependencies": {
        "electron": "^35.0.0",
        "electron-builder": "^25.0.0",
        "eslint": "^9.39.4",
        "globals": "^17.7.0",
        "htmx.org": "^2.0.0",
        "jest": "^29.7.0"
    },
    "build": {
        "appId": "org.anime-db.desktop",
        "productName": "AnimeDB",
        "copyright": "Copyright (c) 2026 Peter Gribanov",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis",
            "arch": [
                "x64"
            ]
        },
        "files": [
            "native/**",
            "app/**",
            "bin/**",
            "resources/**",
            "!app/var/**",
            "!node_modules/**"
        ]
    }
}
