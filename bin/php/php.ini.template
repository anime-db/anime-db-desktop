[PHP]
memory_limit = 256M
upload_max_filesize = 16M
post_max_size = 16M
extension_dir = "{{EXTENSION_DIR}}"
extension=intl
extension=zip
extension=pdo_sqlite
extension=openssl
extension=mbstring
extension=gd

[Date]
date.timezone = {{TIMEZONE}}

[opcache]
opcache.enable=1
opcache.memory_consumption=128

[apcu]
apc.enabled=1
apc.enable_cli=1
apc.shm_size=32M
